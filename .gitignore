# Roblox place files are binary and don't diff or merge -- one person owns the place,
# and the Luau source is mirrored into roblox/ as text instead (see roblox/README.md).
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxm

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS cruft
.DS_Store
Thumbs.db

# studio_sync.py transient mirror -- it is a copy of build/ and lebot_obby/ files that
# the server hands to Studio, not source. The originals are the tracked ones.
tools/src/
