<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="ReplicatedStorage" referent="RBX1">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX2">
			<Properties>
				<string name="Name">Arena</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">Theme</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Every colour and font in the Dragon Arena. Require this; do not write Color3 literals elsewhere.
--
-- This lives in ReplicatedStorage, not ServerScriptService, because the HUD is a LocalScript and
-- needs the same palette the server builds the world from. One source, both sides.
--
-- Two rules the rest of the mode leans on (style guide section 3 and hard rule 7):
--
-- Brightness order, brightest first: hazards (fire, shockwave, lava) -> power-ups and debuff
-- effects -> the dragon's eyes -> the dragon's body -> players -> environment. If something lower
-- on this list renders brighter than something higher, the scene stops reading.
--
-- Warm means dragon and danger; cool means players. Fire, lava, shockwaves and the dragon use
-- reds, oranges and yellows. Power-ups, player abilities and debuffs *on* the dragon use cyan,
-- aqua, violet, magenta, ice and lime. Never give a player effect a warm colour, and never give a
-- dragon attack a cool one. Theme.effectColor is the only place an effect name becomes a colour,
-- so that split cannot drift.

local Theme = {}

Theme.Color = {
	-- Environment: dark, low saturation, never orange
	-- Lifted from the style guide's swatches. The scene is lit almost entirely by lava, so these
	-- render far darker in game than they look here - at the guide's literal values the floor read
	-- as a black hole and you could not tell where you were standing. The brightness *order* in
	-- section 3 is what matters and is unchanged: these are still the dimmest things on screen.
	Obsidian     = Color3.fromRGB(68, 56, 58),    -- arena floor
	ObsidianDeep = Color3.fromRGB(34, 20, 22),    -- floor cracks, pits, crater centres
	Basalt       = Color3.fromRGB(92, 58, 62),    -- pillars, walls, platforms, boulders
	BasaltEdge   = Color3.fromRGB(132, 96, 97),   -- top bevels, so platform edges read

	-- Heat: the brightest things on screen
	Lava         = Color3.fromRGB(242, 98, 42),
	LavaHot      = Color3.fromRGB(251, 155, 58),  -- shockwave core, body of the fire
	WhiteHot     = Color3.fromRGB(255, 226, 154), -- core of the fire, impact flash
	Ember        = Color3.fromRGB(182, 77, 22),   -- trail tails, cooling craters
	Scorch       = Color3.fromRGB(30, 14, 12),    -- burn marks, smoke

	-- Dragon: mid brightness, warm
	DragonScale  = Color3.fromRGB(168, 40, 28),   -- main armour plates
	DragonShade  = Color3.fromRGB(96, 20, 17),    -- underside, plate edges, dormant body
	DragonSpike  = Color3.fromRGB(43, 10, 9),     -- spikes, horns
	DragonIron   = Color3.fromRGB(58, 52, 54),    -- joint rings, pedestal, bolts
	DragonTooth  = Color3.fromRGB(235, 220, 200),
	DragonEye    = Color3.fromRGB(255, 138, 31),  -- eyes and mouth glow (Neon)

	-- Player side: cool colours only
	Power        = Color3.fromRGB(110, 200, 255), -- generic pickup, "ready" glow, survivors win
	Shake        = Color3.fromRGB(0, 240, 200),   -- earthquake
	Slow         = Color3.fromRGB(124, 108, 255), -- molasses
	Inverted     = Color3.fromRGB(224, 64, 251),  -- mirror
	Frozen       = Color3.fromRGB(191, 239, 255), -- freeze
	Lag          = Color3.fromRGB(154, 166, 178), -- fog
	Jammed       = Color3.fromRGB(166, 226, 46),  -- butterfingers

	-- UI
	UiInk        = Color3.fromRGB(11, 7, 9),      -- panels at Transparency 0.35, text strokes
	UiText       = Color3.fromRGB(255, 255, 255),
	UiDanger     = Color3.fromRGB(255, 72, 56),   -- timer under 10 s, elimination flash
}

-- Lighting colours. These belong here for the same reason the part colours do (hard rule 6): they
-- set the whole scene's cast, and a tint nudged in Arena.lua while the palette stays put is how a
-- "dark volcanic" scene quietly turns brown. Starting values from the style guide, section 4 -
-- judge them in Play mode under the final lighting, not as swatches.
Theme.Lighting = {
	Ambient        = Color3.fromRGB(78, 52, 54),
	OutdoorAmbient = Color3.fromRGB(104, 68, 66),
	AtmosphereTint = Color3.fromRGB(120, 50, 40),
	AtmosphereDecay = Color3.fromRGB(60, 20, 25),
	GradeTint      = Color3.fromRGB(255, 240, 232),
}

-- Builder Sans ships with Roblox.
Theme.Font = {
	Display = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.ExtraBold),
	Label   = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold),
}

-- Effect name (as the protocol spells it) -> how it is shown. The protocol's `effects` list in the
-- hello frame is authoritative for *which* effects exist, so this table is looked up, never
-- iterated to build a UI: an effect the server grows that is missing here falls back to Power and
-- its own name, which is ugly but correct, rather than vanishing from the game.
-- The icon itself lives in Icons.lua, drawn from Frames rather than loaded from an asset id. See
-- that file for why: a wrong or unmoderated id renders as nothing, which looks exactly like a bug.
Theme.Effect = {
	earthquake    = { label = "SHAKE",      color = "Shake" },
	molasses      = { label = "SLOWED",     color = "Slow" },
	mirror        = { label = "INVERTED",   color = "Inverted" },
	freeze        = { label = "FROZEN",     color = "Frozen" },
	fog           = { label = "LAGGING",    color = "Lag" },
	butterfingers = { label = "JAW JAMMED", color = "Jammed" },
}

-- The one place an effect name becomes a colour. Unknown names get Power, which is cool - so an
-- effect nobody has themed yet still cannot come out warm and read as a dragon attack.
function Theme.effectColor(name: string): Color3
	local entry = Theme.Effect[name]
	return Theme.Color[entry and entry.color or "Power"]
end

function Theme.effectLabel(name: string): string
	local entry = Theme.Effect[name]
	return entry and entry.label or string.upper(name)
end

return Theme
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">ArenaConfig</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Every tunable number in the Dragon Arena, in one file so none of them hide in logic.
--
-- Two different kinds of number live here, and they are not equally trustworthy:
--
--   MEASURED  - comes from the real arm or the printed sheet. Changing it is a lie about the
--               hardware. There are almost none of these; the sheet size and the arm base arrive
--               in the `hello` frame at run time instead of being written down here.
--   GUESS     - a starting value the style guide marks as "tune in teleop". Every detection
--               threshold is one of these. Section 14 of the style guide lists how to measure
--               each. Do not treat a guess as settled because the demo happened to work once.
--
-- Gameplay numbers (round length, damage, pickup rate) are the designer's call, not the style
-- guide's. They live here so the designer can find them, with no visual code depending on them.

local ArenaConfig = {}

-- Detection: all GUESS. Set the speed thresholds from logged real slams, not by feel. The
-- follower caps how far it can move per tick (`max_relative_target = 10` in robot/arm.py), so its
-- top speed is bounded - a threshold above that can never fire.
ArenaConfig.ARENA_FLOOR_MM  = 25     -- real height above the paper that counts as the arena floor
ArenaConfig.SLAM_HEIGHT_MM  = 12     -- a tip this close to the floor counts as contact
ArenaConfig.SLAM_SPEED_MMS  = 200    -- minimum downward tip speed for a slam
ArenaConfig.SLAM_REARM_MM   = 60     -- the tip must rise this far before it can slam again
ArenaConfig.SLAM_RADIUS     = 35     -- studs the shockwave ring travels
ArenaConfig.SWEEP_HEIGHT_MM = 40     -- a tip this close to the floor counts as low
ArenaConfig.SWEEP_SPEED_MMS = 150    -- minimum sideways tip speed for a sweep
ArenaConfig.FIRE_OPEN_FRAC  = 0.7    -- share of the jaw's observed range that counts as open
ArenaConfig.FIRE_MIN_PCT    = 30     -- lowest gripper reading that can breathe fire
ArenaConfig.FIRE_RANGE      = 60     -- studs, length of the fire cone
ArenaConfig.FIRE_HALF_ANGLE = 18     -- degrees, half-angle of the fire cone
ArenaConfig.STALE_ARM_S     = 0.5    -- arm_age above this makes the dragon dormant

-- FIRE_MIN_PCT sits deliberately above BUTTERFINGERS_OPEN_PCT (18.0 in bridge/effects.py): that
-- debuff holds the jaw at least 18% open for its whole duration, and a fire test on the learned
-- range alone would read that jammed-open jaw as a roar and hand the dragon free fire for 8 s -
-- turning a player's power-up into a reward for the dragon. Raising the floor is not enough on its
-- own either, which is why AttackDetect requires both tests. See the style guide, section 7.
ArenaConfig.BUTTERFINGERS_FLOOR_PCT = 18.0

-- TESTING AGAINST `--source mock`.
--
-- The mock is not a toy: it drives the real IK and the real fitted calibration through a scripted
-- pick-carry-stack, eased with a cosine so peak speed is about 1.57x the average for each move.
-- Worked against that script, the shipped thresholds above mean:
--
--   Fire  - fires out of the box. The mock's jaw runs 20..50, so the learned span is 30, an open
--           jaw reads frac 1.0, and 50 is well above FIRE_MIN_PCT. It will be lit most of the
--           cycle, which is exactly what you want when checking the cone and the scorch marks.
--   Slam  - NEVER fires. The fastest descent ("lower on A1", 150 -> 18 mm in 1.0 s) is down to
--           about 145 mm/s by the time it crosses the slam height, because the ease is already
--           slowing it. That is below SLAM_SPEED_MMS, so nothing triggers.
--   Sweep - NEVER fires, at any speed threshold. The mock only moves sideways at carry height
--           (150 mm), and only moves vertically when it is low, so "low AND moving sideways" is
--           never true. The height gate has to move, not just the speed gate.
--
-- So a mock run that shows fire but no slams and no sweeps is CORRECT, not broken. To see all
-- three, use these while testing against mock, and put the real values back before tuning against
-- the arm - they are chosen to catch the mock's motion, not to describe a dragon:
--
--   ArenaConfig.SLAM_SPEED_MMS  = 100   -- mock peaks ~145 mm/s below the slam height
--   ArenaConfig.SWEEP_HEIGHT_MM = 130   -- so carry height (150 mm) counts as "low"
--   ArenaConfig.SWEEP_SPEED_MMS = 90    -- mock's lateral peak is ~129 mm/s
--
-- Note the mock's grasp height (14 mm) is below ARENA_FLOOR_MM, so the head dips a few studs
-- through the arena floor at the bottom of a pick. That is the floor being above the real table,
-- working as designed, not a rig bug.

-- Velocity is differentiated from each frame's `ts`, never from Heartbeat's delta time: Bridge
-- keeps only the newest frame and drops the rest, so Heartbeat's dt and the gap between the frames
-- actually seen are different numbers. Smoothing spans a few frames so one jittery FK sample
-- cannot read as a slam.
ArenaConfig.VELOCITY_SMOOTH_FRAMES = 3
ArenaConfig.VELOCITY_MAX_GAP_S = 0.5  -- a longer gap than this restarts the estimate rather than
                                      -- dividing a large move by a large dt and inventing speed

-- The jaw's range is learned as the arm runs, the same way bridge/world.py `_grip_state` does,
-- because what counts as "open" depends on the gripper and its calibration. A hardcoded percentage
-- that is wrong for this arm makes the jaw read as permanently shut, and the dragon never breathes.
-- Until the observed span is this wide, fall back to the fixed percentage.
ArenaConfig.GRIP_SPAN_MIN = 15.0
ArenaConfig.GRIP_OPEN_PCT = 35.0      -- fallback "open" reading before the span is known
ArenaConfig.JAW_MAX_DEG = 40          -- lower jaw angle at fully open; 35-45 reads as a roar

-- Dragon build. Thickness is in studs, at the shipped STUDS_PER_MM of 0.46.
ArenaConfig.SEGMENT_THICKNESS = { 16, 14, 12, 11, 12 }   -- shoulders, lower neck, upper neck, skull, head
ArenaConfig.PART_BUDGET = 80          -- the whole dragon; boxes, wedges and cylinders are fine

-- Arena. The floor is the printed sheet: that rectangle is what is physically in front of the arm,
-- and its size arrives in `hello.space.sheet` rather than being written here. The pedestal goes at
-- `hello.space.arm_base_mm`, which is off the top edge of the sheet - so the dragon already sits at
-- the back with the floor fanning out in front of it, with nothing guessed.
--
-- The style guide (section 5) asks for the floor to be the arm's measured *reach* outline instead.
-- Nobody has logged that yet, and the sheet is the honest stand-in: it is the real work surface,
-- and every block the game knows about is on it. When the reach is logged, the outline replaces
-- this rectangle and nothing else in the mode has to change - Arena.lua is the only file that
-- knows the floor's shape.
ArenaConfig.ARENA_MARGIN_MM = 12      -- floor extends this far past the sheet, left/right/far
ArenaConfig.LAVA_WIDTH_MM = 220       -- the lava moat ringing the floor
ArenaConfig.CLIFF_HEIGHT = 90         -- studs, the back wall the pedestal is set against

-- How much of the sheet to actually play on, 0..1. The floor is anchored at the dragon's end and
-- shrinks toward it, so the pedestal stays against the back cliff and the far edge comes closer.
--
-- Shrinking is always safe in the direction that matters: a smaller floor is more reachable, never
-- less, so it cannot create the thing the style guide forbids - a spot the dragon cannot hit.
-- Growing it past 1.0 is the dangerous direction and is why this is capped in Arena.floorFromSheet.
-- Turn it down if the arena feels empty or the dragon cannot cover the ground.
ArenaConfig.ARENA_SCALE = 0.68
ArenaConfig.ARENA_WIDTH_SCALE = 0.78  -- the same, across the sheet rather than away from the arm

-- Round flow. The designer's numbers.
ArenaConfig.ROUND_SECONDS = 120
ArenaConfig.INTERMISSION_SECONDS = 12
ArenaConfig.COUNTDOWN_SECONDS = 3
ArenaConfig.MIN_PLAYERS = 1
ArenaConfig.MAX_PLAYERS = 12

-- Damage. A hit kills outright: the dragon is 8-10x a player's height and the fantasy is dodging,
-- not trading blows. Changing this to a health model is a design decision, not a visual one.
ArenaConfig.SLAM_KNOCKBACK = 120      -- studs/s imparted by the shockwave ring
ArenaConfig.SWEEP_KNOCKBACK = 160     -- studs/s imparted along the tip's sideways velocity
ArenaConfig.HIT_GRACE_S = 0.6         -- a player cannot be hit twice inside this window

-- Pickups. A crystal fills a free ability slot; the player fires it when they choose.
ArenaConfig.PICKUP_INTERVAL_S = 8
ArenaConfig.PICKUP_MAX_ALIVE = 4
ArenaConfig.ABILITY_SLOTS = 4
ArenaConfig.ABILITY_COOLDOWN_S = 3    -- after firing a slot, before that slot can refill

-- What a player's power-up asks the arm for. Duration is clamped server-side by bridge/effects.py
-- LIMITS, so these are requests, not guarantees - the HUD reads back `state.effects[].remaining`
-- for the true value. Asking for more than the cap is harmless and is how the mode says "max".
ArenaConfig.EFFECT_REQUEST = {
	earthquake    = { intensity = 0.8, duration = 5 },
	molasses      = { intensity = 0.9, duration = 10 },
	mirror        = { intensity = 1.0, duration = 15 },
	freeze        = { intensity = 1.0, duration = 3 },
	fog           = { intensity = 0.7, duration = 10 },
	butterfingers = { intensity = 1.0, duration = 8 },
}

-- The aerial operator camera. Height and setback are fractions of the floor's own size, so they
-- stay sensible when ARENA_SCALE changes. Lower HEIGHT to come in closer; raise BACK to sit
-- further behind the dragon and see more of what is in front of it.
ArenaConfig.AERIAL_HEIGHT_FRAC = 0.62
ArenaConfig.AERIAL_BACK_FRAC = 0.38
ArenaConfig.AERIAL_FOV = 55           -- degrees; lower zooms in without moving the camera

-- The operator's aiming aids, drawn on the aerial view only.
--
-- These do not break hard rule 1. That rule forbids telegraphs on the PLAYERS' screens, because
-- players must dodge by watching the dragon rather than reading a marker that says where the next
-- strike lands. The operator's problem is the opposite one and is not about fairness at all: they
-- are flying a real 3D arm from a flat overhead view, where "directly above you" and "thirty studs
-- short" look identical, so without a height cue they are aiming blind. What is drawn here is the
-- arm's CURRENT position - the same class of thing as the dragon's own shadow, which rule 1
-- explicitly allows - and it is built on the operator's client, so no player ever sees it.
ArenaConfig.AIM_RETICLE_RADIUS = 14   -- studs; inside this counts as "over" a player
ArenaConfig.AIM_SHOW = true           -- false strips the aids back to a bare overhead camera

-- Lighting levels, separate from the colours in Theme. The style guide asks for a dark arena lit
-- almost entirely by lava, and these are the knobs for deciding how far to take that. Dark enough
-- that the fire reads, bright enough to see the dragon's armour and where you are standing.
ArenaConfig.LIGHTING = {
	Brightness = 2.6,
	ExposureCompensation = 0.35,
	EnvironmentDiffuseScale = 0.55,
	EnvironmentSpecularScale = 0.7,
	AtmosphereDensity = 0.2,
	AtmosphereHaze = 0.8,
	AtmosphereGlare = 0.15,
	BloomIntensity = 0.85,
	BloomThreshold = 1.6,
	Contrast = 0.08,
	Saturation = 0.06,
}

-- Performance budget (style guide section 12). The effect modules check themselves against these.
ArenaConfig.MAX_IMPACT_MARKS = 20
ArenaConfig.MAX_ENV_POINT_LIGHTS = 8
ArenaConfig.IMPACT_MARK_LIFETIME_S = 30
ArenaConfig.IMPACT_MARK_COOL_S = 3    -- Ember rim fades to Scorch over this

return ArenaConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The server <-> client channel for the arena. Required from both sides.
--
-- The server creates the RemoteEvents on first require; the client waits for them. That ordering
-- is safe because ArenaMain requires this module before any player can have loaded, but the client
-- still uses WaitForChild rather than assuming - a client that joins during a server restart would
-- otherwise error on a missing remote and lose its HUD for the session.
--
-- The operator flag is deliberately NOT here. It is a player attribute instead, because it is set
-- the moment the player joins - before their LocalScript has had a chance to connect - and a
-- RemoteEvent fired at a client that is not listening yet is simply lost. An attribute is state
-- rather than an event: the client reads it whenever it gets around to starting, and still hears
-- about a later change.
--
-- Everything here is display or intent. No damage decision crosses this boundary: the server
-- decides who was hit (AttackFx), and the client is only told what to draw. A client that lies on
-- Fire can ask to spend a slot it does not have, which SlotFire re-checks server-side.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = {
	-- Server -> client
	"Hud",        -- the whole HUD payload: round state, timer, survivors, chips, slots
	"Banner",     -- one-off centre text: countdown, round end, debuff toast
	"Shake",      -- camera shake for a slam: (strength 0..1, seconds)
	-- Client -> server
	"SlotFire",     -- "spend ability slot n"
	"SetOperator",  -- "I am the dragon now" / "I am a player again" (the V key)
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	folder = ReplicatedStorage.Arena:FindFirstChild("Remotes") :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage.Arena
	end
	for _, name in NAMES do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Arena"):WaitForChild("Remotes") :: Folder
end

for _, name in NAMES do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<string name="Name">Icons</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The power-up icons, drawn from plain Frames rather than loaded from the asset library.
--
-- WHY NOT IMAGES. An icon asset has to be uploaded, moderated and referenced by id, and an id that
-- is wrong or not yet approved renders as nothing - a blank slot that looks exactly like a bug.
-- Writing a made-up `rbxassetid` is worse still: it either fails silently or shows whatever that
-- number happens to point at. Frames always render, cost nothing, and take the effect's colour, so
-- the palette rule holds for free: these are player-side, so they come out cool.
--
-- They are deliberately chunky and geometric, which is the same language as the arena's parts.
-- Each one is built from rotated bars and rounded squares inside a square container, sized in
-- Scale so one definition serves a 64 px HUD slot and a pickup's billboard alike.
--
--   Icons.draw(someFrame, "freeze", Theme.Color.Frozen)
--
-- The same icon goes on the pickup in the world and in the slot it fills, which is what makes a
-- crystal you ran across the arena for recognisable when it lands in your bar.

local Icons = {}

local function bar(parent: Instance, color: Color3, x: number, y: number, w: number, h: number,
	rot: number, round: number?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.Rotation = rot
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(round or 0.35, 0)
	c.Parent = f
	return f
end

local function dot(parent: Instance, color: Color3, x: number, y: number, d: number): Frame
	return bar(parent, color, x, y, d, d, 0, 0.5)
end

-- One builder per effect. Keyed by the protocol's own names.
local Draw = {}

-- SHAKE: a jolt. Three bars stepping across at alternating angles.
function Draw.earthquake(p: Instance, c: Color3)
	bar(p, c, 0.32, 0.30, 0.34, 0.12, 32)
	bar(p, c, 0.50, 0.50, 0.34, 0.12, -32)
	bar(p, c, 0.68, 0.70, 0.34, 0.12, 32)
end

-- SLOWED: a falling drop. A round body with a tapered cap above it.
function Draw.molasses(p: Instance, c: Color3)
	dot(p, c, 0.5, 0.62, 0.46)
	bar(p, c, 0.5, 0.30, 0.26, 0.26, 45, 0.25)
end

-- INVERTED: two chevrons pointing into each other across a centre line.
function Draw.mirror(p: Instance, c: Color3)
	bar(p, c, 0.5, 0.5, 0.07, 0.72, 0, 0.5)
	bar(p, c, 0.26, 0.38, 0.09, 0.30, 42)
	bar(p, c, 0.26, 0.62, 0.09, 0.30, -42)
	bar(p, c, 0.74, 0.38, 0.09, 0.30, -42)
	bar(p, c, 0.74, 0.62, 0.09, 0.30, 42)
end

-- FROZEN: a six-pointed star, three bars through the centre.
function Draw.freeze(p: Instance, c: Color3)
	bar(p, c, 0.5, 0.5, 0.10, 0.78, 0, 0.5)
	bar(p, c, 0.5, 0.5, 0.10, 0.78, 60, 0.5)
	bar(p, c, 0.5, 0.5, 0.10, 0.78, 120, 0.5)
end

-- LAGGING: banks of fog, three bars of uneven width.
function Draw.fog(p: Instance, c: Color3)
	bar(p, c, 0.46, 0.32, 0.62, 0.13, 0, 0.5)
	bar(p, c, 0.56, 0.52, 0.52, 0.13, 0, 0.5)
	bar(p, c, 0.44, 0.72, 0.66, 0.13, 0, 0.5)
end

-- JAW JAMMED: a boulder wedged between two jaw plates.
function Draw.butterfingers(p: Instance, c: Color3)
	bar(p, c, 0.5, 0.20, 0.72, 0.12, 0, 0.3)
	bar(p, c, 0.5, 0.80, 0.72, 0.12, 0, 0.3)
	bar(p, c, 0.5, 0.50, 0.40, 0.34, 12, 0.3)
end

-- Anything unthemed, including an effect Python grows that nobody has drawn yet: a plain pickup
-- diamond. Still legible, still the right colour, obviously generic.
local function generic(p: Instance, c: Color3)
	bar(p, c, 0.5, 0.5, 0.44, 0.44, 45, 0.18)
end

-- Draws `name` into `parent`, clearing whatever was there. Returns the square container it used,
-- so a caller can hide or re-tint the whole icon in one go.
function Icons.draw(parent: Instance, name: string, color: Color3): Frame
	local existing = parent:FindFirstChild("Icon")
	if existing then
		existing:Destroy()
	end

	local box = Instance.new("Frame")
	box.Name = "Icon"
	box.BackgroundTransparency = 1
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Position = UDim2.fromScale(0.5, 0.44)
	box.Size = UDim2.fromScale(0.62, 0.62)
	box.Parent = parent

	-- Square, whatever shape the slot is. Without this an icon in a wide chip shears into a
	-- rectangle and the snowflake stops being a snowflake.
	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.AspectRatio = 1
	ratio.Parent = box;

	(Draw[name] or generic)(box, color)
	return box
end

return Icons
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX7">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX8">
			<Properties>
				<string name="Name">Bridge</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- The link to the robot laptop. A ModuleScript, required from a server Script.
--
-- Roblox connects *out* to the Python process, which is the server. Nothing sits in between.
-- Enable Game Settings -> Security -> Allow HTTP Requests first.
--
--   local Bridge = require(game.ServerScriptService.Bridge)
--   Bridge.connect("ws://localhost:8765")     -- or the robot laptop's LAN IP
--   Bridge.onState(function(state) ... end)
--   Bridge.sendEvent("earthquake", 0.7, 4)
--
-- Two things this handles that are easy to get wrong:
--
-- Backpressure. Python sends 30 state frames a second whether or not anything reads them. If
-- a frame handler is slower than that, frames queue and the game drifts behind reality. So
-- MessageReceived only *stores* the newest state; the game reads it on Heartbeat. A dropped
-- frame is correct behaviour here: the next one is always more current.
--
-- Reconnecting. The robot process restarts constantly during a hackathon, and the servo bus
-- on this rig drops out under load. A lost link must never need a Studio restart.

local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Bridge = {}

local ws: any = nil
local url: string = "ws://localhost:8765"
local connected = false
local retryAt = 0
local RETRY_S = 2

local latest: any = nil          -- newest state frame, replaced not queued
local helloFrame: any = nil
local stateHandlers: { (any) -> () } = {}
local helloHandlers: { (any) -> () } = {}

Bridge.framesReceived = 0
Bridge.framesApplied = 0

function Bridge.onState(fn: (any) -> ())
	table.insert(stateHandlers, fn)
end

function Bridge.onHello(fn: (any) -> ())
	table.insert(helloHandlers, fn)
	if helloFrame then
		fn(helloFrame)
	end
end

function Bridge.hello(): any
	return helloFrame
end

function Bridge.isConnected(): boolean
	return connected
end

local function handle(raw: string)
	local ok, frame = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or type(frame) ~= "table" then
		warn("[Bridge] undecodable frame")
		return
	end
	if frame.t == "state" then
		Bridge.framesReceived += 1
		latest = frame                  -- replace, never queue
	elseif frame.t == "hello" then
		helloFrame = frame
		print(("[Bridge] hello: source=%s protocol v%d, %d effects")
			:format(tostring(frame.source), frame.v or 0, #(frame.effects or {})))
		for _, fn in helloHandlers do
			task.spawn(fn, frame)
		end
	elseif frame.t == "error" then
		warn("[Bridge] server error: " .. tostring(frame.message))
	end
end

local function open()
	local ok, client = pcall(function()
		return HttpService:CreateWebStreamClient(Enum.WebStreamClientType.WebSocket, { Url = url })
	end)
	if not ok then
		warn("[Bridge] could not create the client: " .. tostring(client))
		return false
	end
	ws = client
	connected = true
	print("[Bridge] connected to " .. url)

	ws.MessageReceived:Connect(handle)
	-- Not every engine version exposes the same closure signal, so bind whatever is there.
	local closed = (ws :: any).Closed or (ws :: any).Disconnected
	if closed then
		closed:Connect(function()
			connected = false
			ws = nil
			retryAt = os.clock() + RETRY_S
			warn("[Bridge] link closed; retrying")
		end)
	end
	return true
end

function Bridge.connect(wsUrl: string?)
	url = wsUrl or url
	if not open() then
		retryAt = os.clock() + RETRY_S
	end

	RunService.Heartbeat:Connect(function()
		if not connected then
			if os.clock() >= retryAt then
				retryAt = os.clock() + RETRY_S
				open()
			end
			return
		end

		local frame = latest
		if frame == nil then
			return
		end
		latest = nil
		Bridge.framesApplied += 1
		for _, fn in stateHandlers do
			local ok, err = pcall(fn, frame)
			if not ok then
				warn("[Bridge] a state handler errored: " .. tostring(err))
			end
		end
	end)
end

function Bridge.send(frame: any): boolean
	if not connected or ws == nil then
		return false
	end
	local ok, err = pcall(function()
		ws:Send(HttpService:JSONEncode(frame))
	end)
	if not ok then
		warn("[Bridge] send failed: " .. tostring(err))
		connected = false
		retryAt = os.clock() + RETRY_S
	end
	return ok
end

-- Make something happen to the real arm. Python clamps intensity and duration to safe caps,
-- so a wrong number here cannot damage the hardware.
function Bridge.sendEvent(name: string, intensity: number?, duration: number?): boolean
	return Bridge.send({
		t = "event",
		name = name,
		intensity = intensity or 1.0,
		duration = duration or 3.0,
	})
end

function Bridge.sendMode(name: string, level: number?): boolean
	return Bridge.send({ t = "mode", name = name, level = level })
end

return Bridge
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX9">
			<Properties>
				<string name="Name">Mapping</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Sheet millimetres -> Roblox studs. The only place the scale is defined.
--
-- Python sends everything in the sheet frame: origin at the printed sheet's top-left corner,
-- +x right, +y down the page (away from the arm), +z up off the paper. Roblox is Y-up, so
-- sheet y becomes Roblox Z and sheet z becomes Roblox Y.
--
-- One scale applies to all three axes, so a 48 mm block is a true 22-stud cube. That is far
-- above the ~7 studs a default character clears, so Main raises the player's JumpHeight to
-- match instead of squashing the block (see Mapping.jumpHeight). An earlier version scaled
-- height separately via a LEVEL_STUDS constant to keep one block equal to one jumpable step,
-- but a carried block then read as a slab - and the carried block is the one the player rides.
--
-- Retune these live: nothing on the Python side depends on them.

local Mapping = {}

Mapping.STUDS_PER_MM = 0.46      -- the sheet becomes about 129 x 99 studs
Mapping.ORIGIN = Vector3.new(0, 0, 0)   -- where the sheet's top-left corner sits in the world

-- A real cube renders as a real cube: the same scale on all three axes, so a 48 mm block is
-- 22 studs on a side. An earlier version squashed height to a flat 6.5 studs so that one block
-- was exactly one jumpable step, but a carried block then read as a slab instead of the cube it
-- actually is - and the carried block is the thing the player rides, so it is the one that has
-- to look right. Keeping it cubic costs the free step: 22 studs is far above the ~7 stud default
-- jump, so Main raises the player's JumpHeight to match (see Mapping.jumpHeight).
function Mapping.cubeStuds(cubeMm: number): number
	return cubeMm * Mapping.STUDS_PER_MM
end

-- How high a player has to jump to climb onto a block resting on the table, plus margin for
-- hip height and a sloppy approach.
function Mapping.jumpHeight(cubeMm: number): number
	return Mapping.cubeStuds(cubeMm) + 5
end

-- A point as Python sends it ({x, y, z} in mm) -> a world position.
function Mapping.point(p: { x: number, y: number, z: number }): Vector3
	local s = Mapping.STUDS_PER_MM
	return Mapping.ORIGIN + Vector3.new(p.x * s, p.z * s, p.y * s)
end

-- A block's platform centre. Height comes from its stack level, not its scaled mm, except
-- while it is held: then the real carry height is the whole point, so use z directly.
function Mapping.blockPosition(b, cubeMm: number): Vector3
	local s = Mapping.STUDS_PER_MM
	local w = Mapping.cubeStuds(cubeMm)
	local y
	if b.held then
		y = b.z * s + w / 2
	else
		y = b.level * w + w / 2     -- cubes stack on each other, so one level is one cube tall
	end
	return Mapping.ORIGIN + Vector3.new(b.x * s, y, b.y * s)
end

function Mapping.blockSize(cubeMm: number): Vector3
	local w = Mapping.cubeStuds(cubeMm)
	return Vector3.new(w, w, w)
end

-- Sheet yaw is degrees counterclockwise seen from above, wrapping every 90 degrees.
function Mapping.blockOrientation(b): CFrame
	return CFrame.Angles(0, math.rad(-b.yaw), 0)
end

return Mapping
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX10">
			<Properties>
				<string name="Name">ArenaMain</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Dragon Arena. Paste into a Script in ServerScriptService, with Bridge and Mapping beside it and
-- the Arena modules in a Folder named `Arena` (see roblox/arena/README.md for the layout).
--
-- One operator drives the real SO-101 with the leader arm. In here that arm is a giant dragon in a
-- volcanic arena, attacking up to twelve players by slamming, sweeping and breathing fire. Players
-- dodge and grab power-ups that fire real effects back at the real arm. Survive the timer and the
-- players win; kill everyone and the dragon does.
--
-- The order of operations matters in two places:
--
--   `hello` before anything is built. The sheet size and the arm base arrive in that frame, and the
--   arena floor is built from them - so Arena:build waits for it rather than guessing a rectangle.
--   Pickups likewise waits for `hello.effects` before it can spawn anything.
--
--   Dragon before effects, every frame. DragonEffects positions its overlays off the segment
--   pivots, so the dragon has to have moved first or every overlay runs one frame behind the body
--   it is wrapped around.
--
-- This script does not interpret the arm itself. Detection lives in AttackDetect, visuals in
-- AttackFx and DragonEffects, and the floor in Arena. What is here is wiring.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Bridge = require(script.Parent.Bridge)
local Mapping = require(script.Parent.Mapping)
local Theme = require(ReplicatedStorage.Arena.Theme)
-- Required for its side effect, not its return: requiring Remotes on the server is what creates
-- the RemoteEvent instances. Doing it here, at the top of the one script that starts the mode,
-- means they exist before any player's LocalScript can WaitForChild them. The modules below also
-- require it, so this is belt and braces - but the ordering is load-bearing and worth stating.
local Remotes = require(ReplicatedStorage.Arena.Remotes)

local modules = script.Parent.Arena
local Arena = require(modules.Arena)
local DragonArm = require(modules.DragonArm)
local AttackDetect = require(modules.AttackDetect)
local AttackFx = require(modules.AttackFx)
local DragonEffects = require(modules.DragonEffects)
local Pickups = require(modules.Pickups)
local Rounds = require(modules.Rounds)
local Sound = require(modules.Sound)

-- localhost works when Studio and the robot process share a laptop. Otherwise the robot laptop's
-- LAN IP, e.g. "ws://192.168.1.42:8765".
local URL = "ws://localhost:8765"

-- Who sees the overhead operator camera. Set this to the operator's Roblox username; anyone else
-- plays normally. Left empty, nobody gets it - which is the right default for a public server.
local OPERATOR_NAME = ""

-- Marked with an attribute rather than a RemoteEvent. This is decided the instant the player
-- joins, which is before their LocalScript has connected to anything, and an event fired at a
-- client that is not listening yet is just lost - the operator would get a normal player view and
-- no obvious reason why. An attribute is state the client can read whenever it starts.
local OPERATOR_ATTRIBUTE = "ArenaOperator"

-- Characters are handed out by Rounds, never automatically. Spectating in this mode means having
-- no body at all, and an eliminated player whose character reloaded on a timer would be back in
-- the arena mid-round: uncounted, un-killable, and still solid enough for the dragon to hit.
Players.CharacterAutoLoads = false

local arena = Arena.new(workspace)
local dragon = DragonArm.new(workspace)
local detect = AttackDetect.new()
local fx = AttackFx.new(workspace, arena, dragon)
local effects = DragonEffects.new(dragon)
local pickups = Pickups.new(workspace, arena, Bridge)
local rounds = Rounds.new(arena, dragon, pickups)
local sound = Sound.new(workspace)

-- ---------------------------------------------------------------------------------------------
-- Attacks
-- ---------------------------------------------------------------------------------------------

detect.onSlam = function(tipMm, speed)
	fx:slam(tipMm, speed)
	sound:at("slam", Mapping.point(tipMm), 0.8)
end

detect.onSweepStart = function()
	fx:sweepStart()
	local head = dragon.segments[5]
	if head then
		sound:startLoop("sweep", head.core, 0.5)
	end
end
detect.onSweep = function(tipMm, dir) fx:sweep(tipMm, dir) end
detect.onSweepEnd = function()
	fx:sweepEnd()
	sound:stopLoop("sweep")
end

detect.onFireStart = function(frac)
	fx:fireStart(frac)
	local head = dragon.segments[5]
	if head then
		sound:at("roar", head.core.Position, 0.9)
		sound:startLoop("flame", head.core, 0.6)
	end
end
detect.onFire = function(frac) fx:fire(frac) end
detect.onFireEnd = function()
	fx:fireEnd()
	sound:stopLoop("flame")
end

-- A hit is the dragon's doing, so the round decides what it costs. AttackFx only reports it.
fx.onHit = function(player, kind)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		sound:at("eliminated", root.Position, 0.6)
	end
	rounds:eliminate(player, kind)
end

-- A player landed a debuff on the real arm. The toast says who and what; it is deliberately the
-- effect's own cool colour, never a warm one, because this is the players' win.
pickups.onLanded = function(player, name)
	rounds:banner("DRAGON " .. Theme.effectLabel(name) .. "!", Theme.effectColor(name), 1.5, player.Name)
	sound:ui("debuff", 0.5)
end

-- ---------------------------------------------------------------------------------------------
-- The link
-- ---------------------------------------------------------------------------------------------

Bridge.onHello(function(h)
	cubeMm = (h.space and h.space.cube_mm) or cubeMm
	arena:build(h.space)
	pickups:setEffects(h.effects)
	sound:ambience()
	print(("[Arena] source=%s, floor from sheet %0.0f x %0.0f mm, arm base (%0.1f, %0.1f)")
		:format(tostring(h.source),
			h.space and h.space.sheet and h.space.sheet.w_mm or 0,
			h.space and h.space.sheet and h.space.sheet.h_mm or 0,
			h.space and h.space.arm_base_mm and h.space.arm_base_mm[1] or 0,
			h.space and h.space.arm_base_mm and h.space.arm_base_mm[2] or 0))
	rounds:start()
end)

Bridge.onState(function(s)
	-- Dragon first: everything below reads where its parts ended up.
	dragon:update(s.arm, s.arm_age)
	effects:update(s.effects)
	rounds:setEffects(s.effects)

	-- Always called, including on a stale frame. A stale arm is a harmless dragon (hard rule 5),
	-- and AttackDetect is what enforces that - it needs the frame to notice the staleness and shut
	-- down whatever was running. Skipping the call would leave a live fire cone burning on a dead
	-- link, still killing players with nobody driving it.
	detect:update(s)
end)

Bridge.connect(URL)

-- ---------------------------------------------------------------------------------------------
-- Players
-- ---------------------------------------------------------------------------------------------

-- The real cube size arrives with `hello`; 48 is only what it is until then. Blocks render as true
-- cubes at the shipped scale, so a resting block is a ~22-stud wall - far past the ~7 studs a
-- default character clears. The jump is scaled to the block rather than the block flattened to the
-- jump, exactly as the obby's Main does, and Arena's platform heights follow the same number.
local cubeMm = 48

local function onCharacter(player: Player, char: Model)
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	if hum and hum:IsA("Humanoid") then
		hum.UseJumpPower = false        -- JumpHeight is ignored while UseJumpPower is true
		hum.JumpHeight = Mapping.jumpHeight(cubeMm)
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char) onCharacter(player, char) end)

	-- The operator is excluded *before* playerAdded, which is what hands out characters: the
	-- overhead view is scriptable and a body on the floor would be one more thing to dodge.
	if OPERATOR_NAME ~= "" and player.Name == OPERATOR_NAME then
		rounds:exclude(player)
		player:SetAttribute(OPERATOR_ATTRIBUTE, true)
		return
	end

	rounds:playerAdded(player)
	if rounds.state == "Waiting" then
		rounds:start()
	end
end)

Players.PlayerRemoving:Connect(function(player)
	rounds:playerRemoving(player)
end)

-- The V key on any client. The camera change is the client's business, but who is the dragon is
-- the server's: they leave the round, lose their character, and stop counting as a survivor.
Remotes.SetOperator.OnServerEvent:Connect(function(player, on)
	rounds:setOperator(player, on == true)
end)

RunService.Heartbeat:Connect(function(dt)
	pickups:step(dt)
	rounds:step(dt)
end)

local report = 0
RunService.Heartbeat:Connect(function(dt)
	report += dt
	if report >= 5 then
		report = 0
		print(("[Arena] link=%s state=%s dormant=%s frames=%d applied=%d")
			:format(tostring(Bridge.isConnected()), rounds.state,
				tostring(dragon:isDormant()), Bridge.framesReceived, Bridge.framesApplied))
	end
end)

return nil
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX11">
			<Properties>
				<string name="Name">Arena</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX12">
				<Properties>
					<string name="Name">Arena</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The volcanic arena: floor, lava, cliffs, cover, background, lighting and impact marks.
--
-- THE FLOOR IS THE PRINTED SHEET. The style guide (section 5) asks for the floor to be the outline
-- the real tip can reach, logged by driving the arm around with the jaw near the table. Nobody has
-- logged that yet, and until they do the sheet is the honest stand-in rather than a guess: it is
-- the actual work surface in front of the arm, its size arrives in `hello.space.sheet` instead of
-- being written down, and every block the game knows about sits on it.
--
-- The pedestal goes at `hello.space.arm_base_mm`, which is off the *top* edge of the sheet - the
-- arm really does stand behind the paper. So the guide's layout falls out of the real geometry for
-- free: the dragon is at the back against the cliff, and the floor fans out in front of it. No
-- round arena, so no safe spot behind the dragon where the shoulder pan cannot turn.
--
-- When the reach outline is finally logged, it replaces `floorFromSheet` and nothing else in the
-- mode changes. This is the only file that knows the floor's shape.
--
-- THE FLOOR IS ABOVE THE REAL TABLE. The arena floor sits at ARENA_FLOOR_MM above the paper, so
-- the dragon's head hits the in-game floor while the real jaw is still safely in the air. The
-- operator must never have to bang the arm into the table to land a slam.
--
--   local arena = Arena.new(workspace)
--   Bridge.onHello(function(h) arena:build(h.space) end)

local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Arena.Theme)
local ArenaConfig = require(ReplicatedStorage.Arena.ArenaConfig)
local Mapping = require(script.Parent.Parent.Mapping)

local Arena = {}
Arena.__index = Arena

local C = Theme.Color

local function part(parent: Instance, name: string, color: Color3, material: Enum.Material,
	size: Vector3, cf: CFrame, collide: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = collide ~= false
	p.CanQuery = collide ~= false
	p.CanTouch = false
	p.Material = material
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function Arena.new(parent: Instance)
	local self = setmetatable({}, Arena)
	self.model = Instance.new("Model")
	self.model.Name = "Arena"
	self.model.Parent = parent
	self.marks = {} :: { BasePart }      -- newest last; the oldest is removed past the budget
	self.lights = 0
	self.floorTopY = 0
	self.bounds = nil :: any
	self.built = false
	return self
end

-- Where the arena floor's *surface* is, in studs. Attack detection compares the real tip against
-- ARENA_FLOOR_MM in millimetres, but the visuals need the same plane in world units, and taking it
-- from Mapping is what keeps the two from drifting apart when the scale is retuned.
function Arena.floorY(self): number
	return Mapping.point({ x = 0, y = 0, z = ArenaConfig.ARENA_FLOOR_MM }).Y
end

-- The sheet rectangle, grown by the margin, with the back edge pushed out far enough to stand the
-- pedestal on. Returns millimetre bounds in the sheet frame.
function Arena.floorFromSheet(self, space: any): any
	local w = (space and space.sheet and space.sheet.w_mm) or 279.4
	local h = (space and space.sheet and space.sheet.h_mm) or 215.9
	local base = (space and space.arm_base_mm) or { w / 2, -44.5 }
	local m = ArenaConfig.ARENA_MARGIN_MM

	-- Capped at 1. Shrinking the floor is safe - a smaller floor is more reachable - but growing it
	-- past the sheet would hand players ground the arm cannot cover, which is the one thing the
	-- style guide says must never happen.
	local depthScale = math.clamp(ArenaConfig.ARENA_SCALE or 1, 0.15, 1)
	local widthScale = math.clamp(ArenaConfig.ARENA_WIDTH_SCALE or 1, 0.15, 1)

	-- The arm base is at a negative y (behind the top edge of the paper), so the floor has to reach
	-- back past it for the pedestal to stand on something. That back edge is the anchor: the floor
	-- shrinks *toward the dragon*, keeping it against the cliff while the far edge comes closer,
	-- rather than shrinking toward the middle and leaving the pedestal floating in the lava.
	local y0 = math.min(-m, base[2] - m)
	local y1 = y0 + ((h + m) - y0) * depthScale

	-- Across the sheet there is no anchor to respect, so this shrinks about the centre.
	local cx = w / 2
	local halfW = (w / 2 + m) * widthScale

	return {
		x0 = cx - halfW,
		x1 = cx + halfW,
		y0 = y0,
		y1 = y1,
		baseX = base[1],
		baseY = base[2],
		sheetW = w,
		sheetH = h,
	}
end

function Arena.build(self, space: any)
	if self.built then
		return
	end
	self.built = true
	local b = self:floorFromSheet(space)
	self.bounds = b
	-- Platform heights are in units of the player's jump, which is in turn scaled to the real cube
	-- size from `hello`. Hardcoding either one puts a ledge out of reach the moment the scale or
	-- the block size changes.
	self.cubeMm = (space and space.cube_mm) or 48
	local s = Mapping.STUDS_PER_MM
	local floorY = self:floorY()
	self.floorTopY = floorY

	local function world(xMm: number, yMm: number, yStuds: number): Vector3
		return Mapping.ORIGIN + Vector3.new(xMm * s, yStuds, yMm * s)
	end

	local wx = (b.x1 - b.x0) * s
	local wz = (b.y1 - b.y0) * s
	local cx = (b.x0 + b.x1) / 2
	local cz = (b.y0 + b.y1) / 2

	-- Floor. Dark obsidian, mostly flat. Orange stays off it except at the lava edge and on
	-- temporary impact glow, so fire and shockwaves have something dark to stand out against.
	local floor = part(self.model, "Floor", C.Obsidian, Enum.Material.Basalt,
		Vector3.new(wx, 4, wz), CFrame.new(world(cx, cz, floorY - 2)))
	self.floor = floor

	-- A few thin cracks, Neon at high transparency. Few on purpose: a floor lit all over competes
	-- with the fire.
	for k = 1, 6 do
		local fx = b.x0 + (b.x1 - b.x0) * (k / 7)
		local crack = part(self.model, "Crack" .. k, C.Ember, Enum.Material.Neon,
			Vector3.new(0.6, 0.2, wz * (0.3 + 0.4 * ((k * 7) % 5) / 5)),
			CFrame.new(world(fx, cz, floorY + 0.02)) * CFrame.Angles(0, math.rad((k % 3) * 12 - 12), 0),
			false)
		crack.Transparency = 0.4
	end

	self:buildLava(b, s, floorY)
	self:buildCliffs(b, s, floorY)
	self:buildCover(b, s, floorY)
	self:buildBackground(b, s, floorY)
	self:applyLighting()
end

-- Lava surrounds the reachable floor: everything the dragon cannot hit must be fatal, or players
-- find a corner to stand in and the round stops being a dodge.
function Arena.buildLava(self, b: any, s: number, floorY: number)
	local lw = ArenaConfig.LAVA_WIDTH_MM
	local sides = {
		{ x0 = b.x0 - lw, x1 = b.x1 + lw, y0 = b.y0 - lw, y1 = b.y0 },
		{ x0 = b.x0 - lw, x1 = b.x1 + lw, y0 = b.y1,      y1 = b.y1 + lw },
		{ x0 = b.x0 - lw, x1 = b.x0,      y0 = b.y0,      y1 = b.y1 },
		{ x0 = b.x1,      x1 = b.x1 + lw, y0 = b.y0,      y1 = b.y1 },
	}
	for i, q in sides do
		local size = Vector3.new((q.x1 - q.x0) * s, 3, (q.y1 - q.y0) * s)
		local at = Mapping.ORIGIN + Vector3.new((q.x0 + q.x1) / 2 * s, floorY - 2.4, (q.y0 + q.y1) / 2 * s)
		part(self.model, "Lava" .. i, C.Lava, Enum.Material.CrackedLava, size, CFrame.new(at))
		-- A Neon strip along the inner edge does the glow. Neon plus Bloom is far cheaper than a
		-- light, which matters because Future lighting makes lights expensive.
		local glow = part(self.model, "LavaGlow" .. i, C.LavaHot, Enum.Material.Neon,
			Vector3.new(size.X, 0.4, size.Z),
			CFrame.new(at + Vector3.new(0, 1.6, 0)), false)
		glow.Transparency = 0.3
	end

	-- At most MAX_ENV_POINT_LIGHTS in the lava. Everything else glows with Neon and Bloom.
	local n = math.min(ArenaConfig.MAX_ENV_POINT_LIGHTS, 8)
	for k = 1, n do
		local a = (k / n) * math.pi * 2
		local host = part(self.model, "LavaLight" .. k, C.Lava, Enum.Material.Neon,
			Vector3.new(1, 1, 1),
			CFrame.new(Mapping.ORIGIN + Vector3.new(
				((b.x0 + b.x1) / 2 + math.cos(a) * (b.x1 - b.x0) * 0.62) * s,
				floorY + 1,
				((b.y0 + b.y1) / 2 + math.sin(a) * (b.y1 - b.y0) * 0.62) * s)), false)
		host.Transparency = 1
		local l = Instance.new("PointLight")
		l.Color = C.Lava
		l.Range = 20
		l.Brightness = 2
		l.Parent = host
		self.lights += 1
	end
end

-- The back wall the pedestal stands against: the dragon's lair. Side walls keep the camera from
-- looking out into nothing.
function Arena.buildCliffs(self, b: any, s: number, floorY: number)
	local h = ArenaConfig.CLIFF_HEIGHT
	local lw = ArenaConfig.LAVA_WIDTH_MM
	local back = part(self.model, "BackCliff", C.Basalt, Enum.Material.Rock,
		Vector3.new((b.x1 - b.x0 + lw * 2) * s, h, 10),
		CFrame.new(Mapping.ORIGIN + Vector3.new((b.x0 + b.x1) / 2 * s, floorY + h / 2, (b.y0 - 5) * s)))
	part(self.model, "BackCliffEdge", C.BasaltEdge, Enum.Material.Slate,
		Vector3.new(back.Size.X, 1.2, 11),
		CFrame.new(back.Position + Vector3.new(0, h / 2, 0)), false)
end

-- Cover and height. Rocks block fire (the cone raycasts), and the low platforms give somewhere to
-- jump. Everything is inside the floor, so there is nowhere the dragon cannot reach.
function Arena.buildCover(self, b: any, s: number, floorY: number)
	local jump = Mapping.jumpHeight(self.cubeMm or 48)
	local spots = {
		{ fx = 0.22, fy = 0.34, r = 9,  plat = false },
		{ fx = 0.76, fy = 0.30, r = 11, plat = false },
		{ fx = 0.50, fy = 0.66, r = 8,  plat = false },
		{ fx = 0.14, fy = 0.72, r = 7,  plat = true,  lift = 0.55 },
		{ fx = 0.86, fy = 0.70, r = 7,  plat = true,  lift = 0.55 },
		{ fx = 0.34, fy = 0.52, r = 6,  plat = true,  lift = 1.15 },
		{ fx = 0.66, fy = 0.50, r = 6,  plat = true,  lift = 1.15 },
	}
	for i, sp in spots do
		local xMm = b.x0 + (b.x1 - b.x0) * sp.fx
		local yMm = b.y0 + (b.y1 - b.y0) * sp.fy
		-- Platform heights are given in units of the arena's JumpHeight, so retuning the scale
		-- retunes the climb instead of silently putting a ledge out of reach.
		local y = floorY + (sp.plat and jump * (sp.lift or 0.55) or sp.r * 0.4)
		local at = Mapping.ORIGIN + Vector3.new(xMm * s, y, yMm * s)
		if sp.plat then
			part(self.model, "Platform" .. i, C.Basalt, Enum.Material.Slate,
				Vector3.new(sp.r * 2.6, 2.2, sp.r * 2.6), CFrame.new(at))
			part(self.model, "PlatformEdge" .. i, C.BasaltEdge, Enum.Material.Slate,
				Vector3.new(sp.r * 2.7, 0.5, sp.r * 2.7),
				CFrame.new(at + Vector3.new(0, 1.3, 0)), false)
		else
			local rock = part(self.model, "Rock" .. i, C.Basalt, Enum.Material.Rock,
				Vector3.new(sp.r * 1.7, sp.r * 1.5, sp.r * 1.9),
				CFrame.new(at) * CFrame.Angles(0, i * 0.7, 0.06))
			part(self.model, "RockEdge" .. i, C.BasaltEdge, Enum.Material.Slate,
				Vector3.new(sp.r * 1.4, 0.5, sp.r * 1.6),
				rock.CFrame * CFrame.new(0, sp.r * 0.75, 0), false)
		end
	end
end

-- Tall spires and lavafalls outside the play area, dark against the sky. They frame the dragon,
-- and must never be brighter than it: a background that out-glows the dragon flattens the scene.
function Arena.buildBackground(self, b: any, s: number, floorY: number)
	local lw = ArenaConfig.LAVA_WIDTH_MM
	for k = 1, 10 do
		local a = (k / 10) * math.pi * 2 + 0.3
		local dist = (b.x1 - b.x0) * 0.7 + lw
		local xMm = (b.x0 + b.x1) / 2 + math.cos(a) * dist
		local yMm = (b.y0 + b.y1) / 2 + math.sin(a) * dist * 0.8
		local h = 70 + (k % 4) * 45
		local spire = part(self.model, "Spire" .. k, C.Basalt, Enum.Material.Rock,
			Vector3.new(14 + (k % 3) * 6, h, 14 + (k % 2) * 7),
			CFrame.new(Mapping.ORIGIN + Vector3.new(xMm * s, floorY + h / 2 - 6, yMm * s))
				* CFrame.Angles(0, a, 0),
			false)
		if k % 3 == 0 then
			local fall = part(self.model, "Lavafall" .. k, C.Lava, Enum.Material.Neon,
				Vector3.new(3, h * 0.7, 1.5),
				spire.CFrame * CFrame.new(spire.Size.X / 2 + 0.6, -h * 0.1, 0), false)
			fall.Transparency = 0.25
		end
	end
end

function Arena.applyLighting(self)
	-- Technology is set in the Studio Properties panel, not from a script: Future needs a restart
	-- of the lighting pass to take effect properly and scripting it mid-session gives a different
	-- result than shipping it. See the arena README.
	local L = ArenaConfig.LIGHTING
	Lighting.ClockTime = 0
	Lighting.Brightness = L.Brightness
	Lighting.ExposureCompensation = L.ExposureCompensation
	Lighting.Ambient = Theme.Lighting.Ambient
	Lighting.OutdoorAmbient = Theme.Lighting.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale
	Lighting.GlobalShadows = true

	local function ensure(class: string, name: string): Instance
		local inst = Lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(class)
			inst.Name = name
			inst.Parent = Lighting
		end
		return inst
	end

	local atm = ensure("Atmosphere", "ArenaAtmosphere") :: Atmosphere
	atm.Density = L.AtmosphereDensity
	atm.Offset = 0.1
	atm.Color = Theme.Lighting.AtmosphereTint
	atm.Decay = Theme.Lighting.AtmosphereDecay
	atm.Glare = L.AtmosphereGlare
	atm.Haze = L.AtmosphereHaze

	-- Neon has to actually glow, or the whole brightness order collapses: the hazards stop out-
	-- ranking the dragon and the scene reads flat.
	local bloom = ensure("BloomEffect", "ArenaBloom") :: BloomEffect
	bloom.Intensity = L.BloomIntensity
	bloom.Size = 28
	bloom.Threshold = L.BloomThreshold

	local cc = ensure("ColorCorrectionEffect", "ArenaGrade") :: ColorCorrectionEffect
	cc.Contrast = L.Contrast
	cc.Saturation = L.Saturation
	cc.TintColor = Theme.Lighting.GradeTint

	local sky = ensure("Sky", "ArenaSky") :: Sky
	sky.CelestialBodiesShown = false
	sky.StarCount = 0

	self:buildEmbers()
end

-- Ambient embers drifting up over the arena. One emitter, low rate: this is atmosphere, and it has
-- to leave room in the ~400-particle budget for the fire and the slams.
function Arena.buildEmbers(self)
	if not self.bounds then
		return
	end
	local b = self.bounds
	local s = Mapping.STUDS_PER_MM
	local host = part(self.model, "EmberSource", C.Ember, Enum.Material.Neon, Vector3.new(1, 1, 1),
		CFrame.new(Mapping.ORIGIN + Vector3.new((b.x0 + b.x1) / 2 * s, self.floorTopY + 30,
			(b.y0 + b.y1) / 2 * s)), false)
	host.Transparency = 1

	local e = Instance.new("ParticleEmitter")
	e.Name = "Embers"
	e.Color = ColorSequence.new(C.Ember, C.LavaHot)
	e.Size = NumberSequence.new(0.4)
	e.Lifetime = NumberRange.new(4, 7)
	e.Rate = 6
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(25, 25)
	e.LightEmission = 1
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.EmissionDirection = Enum.NormalId.Top
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	-- Sized before the emitter is parented: the Box shape emits from the host's volume, so a host
	-- still 1x1x1 at that moment drips embers from a single point above the middle of the arena.
	host.Size = Vector3.new((b.x1 - b.x0) * s, 2, (b.y1 - b.y0) * s)
	e.Parent = host
end

-- ---------------------------------------------------------------------------------------------
-- Impact marks. Craters and scorch patches are left *after* a hit, which hard rule 1 allows -
-- they are history, not a prediction of where the next strike lands.
-- ---------------------------------------------------------------------------------------------

function Arena.trimMarks(self)
	while #self.marks > ArenaConfig.MAX_IMPACT_MARKS do
		local oldest = table.remove(self.marks, 1)
		if oldest then
			oldest:Destroy()
		end
	end
end

-- A crater: an ObsidianDeep centre with an Ember rim that cools to Scorch over a few seconds, then
-- is cleaned up. Without the cleanup the floor fills with rims and the newest slam stops reading.
function Arena.addCrater(self, at: Vector3, radius: number)
	local y = self.floorTopY + 0.05
	local centre = part(self.model, "Crater", C.ObsidianDeep, Enum.Material.Basalt,
		Vector3.new(radius * 1.6, 0.3, radius * 1.6),
		CFrame.new(at.X, y, at.Z), false)
	centre.Shape = Enum.PartType.Cylinder
	centre.CFrame = CFrame.new(at.X, y, at.Z) * CFrame.Angles(0, 0, math.pi / 2)

	local rim = part(self.model, "CraterRim", C.Ember, Enum.Material.Neon,
		Vector3.new(radius * 1.9, 0.22, radius * 1.9),
		CFrame.new(at.X, y + 0.02, at.Z), false)
	rim.Shape = Enum.PartType.Cylinder
	rim.CFrame = CFrame.new(at.X, y + 0.02, at.Z) * CFrame.Angles(0, 0, math.pi / 2)
	rim.Transparency = 0.1
	rim.Parent = centre

	table.insert(self.marks, centre)
	self:trimMarks()

	-- The rim cools from Ember to Scorch. This is the mark changing after the fact, not the dragon
	-- being animated, so hard rule 2 is untouched.
	task.spawn(function()
		local t0 = os.clock()
		local cool = ArenaConfig.IMPACT_MARK_COOL_S
		while rim.Parent and os.clock() - t0 < cool do
			local f = (os.clock() - t0) / cool
			rim.Color = C.Ember:Lerp(C.Scorch, f)
			rim.Transparency = 0.1 + 0.6 * f
			task.wait(0.05)
		end
		if rim.Parent then
			rim.Material = Enum.Material.Basalt
			rim.Color = C.Scorch
			rim.Transparency = 0.3
		end
	end)
	Debris:AddItem(centre, ArenaConfig.IMPACT_MARK_LIFETIME_S)
end

function Arena.addScorch(self, at: Vector3, radius: number)
	local patch = part(self.model, "Scorch", C.Scorch, Enum.Material.Basalt,
		Vector3.new(radius * 1.5, 0.25, radius * 1.5),
		CFrame.new(at.X, self.floorTopY + 0.04, at.Z), false)
	patch.Shape = Enum.PartType.Cylinder
	patch.CFrame = CFrame.new(at.X, self.floorTopY + 0.04, at.Z) * CFrame.Angles(0, 0, math.pi / 2)
	patch.Transparency = 0.25
	table.insert(self.marks, patch)
	self:trimMarks()
	Debris:AddItem(patch, ArenaConfig.IMPACT_MARK_LIFETIME_S)
end

-- Is this world point on the playable floor? Pickups and spawns ask, so nothing lands in the lava
-- or somewhere the dragon cannot reach.
function Arena.inBounds(self, at: Vector3): boolean
	if not self.bounds then
		return false
	end
	local b = self.bounds
	local s = Mapping.STUDS_PER_MM
	local local_ = at - Mapping.ORIGIN
	local xMm = local_.X / s
	local yMm = local_.Z / s
	return xMm > b.x0 and xMm < b.x1 and yMm > b.y0 and yMm < b.y1
end

-- A random point on the floor, inside reach, for a pickup or a spawn. Keeps clear of the pedestal
-- end, where the tip cannot get down to the floor.
function Arena.randomFloorPoint(self, rng: Random): Vector3
	local b = self.bounds
	local s = Mapping.STUDS_PER_MM
	local xMm = b.x0 + (b.x1 - b.x0) * rng:NextNumber(0.08, 0.92)
	-- The dead zone close to the base: the tip cannot reach the floor there, so nothing spawns in
	-- it. Players must never find a spot the dragon cannot hit.
	local yMm = b.y0 + (b.y1 - b.y0) * rng:NextNumber(0.3, 0.94)
	return Mapping.ORIGIN + Vector3.new(xMm * s, self.floorTopY + 3, yMm * s)
end

return Arena
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX13">
				<Properties>
					<string name="Name">DragonArm</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The dragon: a crimson robot arm wearing scale armour, sitting exactly where the real SO-101 is.
--
-- A separate rig from SkyArm.lua on purpose - SkyArm's own comment says the 1v1 arm is its own
-- thing. The input is identical: `arm.points`, base to tip, converted with Mapping.point. Python
-- already ran the kinematics against the arm's URDF and fitted calibration, so there are no link
-- lengths here, no Motor6D assembly, and no per-joint sign to discover by wiggling.
--
--   local dragon = DragonArm.new(workspace)
--   Bridge.onState(function(s) dragon:update(s.arm, s.arm_age) end)
--
-- Four things in here exist because the obvious version is wrong:
--
-- 1. BUILD ONCE, THEN MOVE. Link lengths never change - they come from forward kinematics on a
--    real URDF. So each segment is built once from the first frame's span and afterwards only
--    moved, with Model:PivotTo. Resizing a segment every frame stretches every decoration welded
--    to it: the spikes grow and shrink, and the armour plates slide.
--
-- 2. NOT CFrame.lookAt(a, b). Its default up vector is world up. In a slam the head points
--    straight down, the look direction goes parallel to world up, and the CFrame flips and spins -
--    the spikes end up underneath at the exact moment the player is watching the head. The up
--    vector here is the normal of the arm's own plane (through shoulder_lift, elbow_flex and
--    wrist_flex), which is perpendicular to every segment by construction and is defined no matter
--    where the head points. When the arm straightens that plane degenerates, so the previous
--    frame's normal is kept rather than snapping to something arbitrary.
--
-- 3. HEAD ROLL COMES FROM THE JOINT, NOT THE POINTS. Three points on a line say nothing about
--    rotation about that line, so the head's roll is read from arm.joints.wrist_roll directly.
--
-- 4. THE JAW'S RANGE IS LEARNED, NOT ASSUMED. Mirrors bridge/world.py `_grip_state`: what counts
--    as "open" depends on the gripper and its calibration, so a fixed percentage that is wrong for
--    this arm pins the jaw shut forever and the dragon never breathes fire.
--
-- Hard rule 2 governs this whole file: the dragon is always where the real arm is. Nothing in here
-- tweens, eases, bobs or recoils. If the visual drifts off the hitbox, hits look unfair - and
-- under `earthquake` the real arm is already shaking, so adding shake on top would double it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Arena.Theme)
local ArenaConfig = require(ReplicatedStorage.Arena.ArenaConfig)
local Mapping = require(script.Parent.Parent.Mapping)

local DragonArm = {}
DragonArm.__index = DragonArm

local C = Theme.Color

-- Segment index -> what it is. Point i to point i+1, with arm.points base to tip.
local SEGMENTS = {
	{ name = "Shoulders",  thickness = 16, spikes = 0, plates = 2 },
	{ name = "LowerNeck",  thickness = 14, spikes = 5, plates = 3 },
	{ name = "UpperNeck",  thickness = 12, spikes = 4, plates = 3 },
	{ name = "Skull",      thickness = 11, spikes = 0, plates = 1 },
	{ name = "Head",       thickness = 12, spikes = 0, plates = 0 },
}

local HEAD_INDEX = 5

-- A decoration: seen, never hit. The core segment parts are the hitbox, and nothing else may be,
-- or "what you see is what hits" (hard rule 3) stops being true.
local function decor(parent: Instance, name: string, color: Color3, size: Vector3,
	material: Enum.Material?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = size
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function DragonArm.new(parent: Instance)
	local self = setmetatable({}, DragonArm)
	self.model = Instance.new("Model")
	self.model.Name = "Dragon"
	self.model.Parent = parent

	self.segments = {} :: { any }     -- [i] = { model, core, length, decor... }
	self.joints = {} :: { Model }
	self.built = false
	self.normal = Vector3.new(0, 1, 0)   -- last good arm-plane normal; kept when the arm straightens
	self.points = {} :: { Vector3 }

	-- The jaw's observed range, learned as it runs (see _jawFraction).
	self.gripLo = nil :: number?
	self.gripHi = nil :: number?
	self.jawFrac = 0

	self.dormant = false
	self.pedestal = nil :: Model?
	return self
end

-- Learned jaw opening, 0 (shut) to 1 (as open as this gripper has ever been seen).
--
-- Straight from bridge/world.py `_grip_state`, and for the same reason: absolute thresholds are a
-- trap, because the reading that means "open" differs from arm to arm. Once the jaw has been seen
-- both open and shut the span is known and the fraction is correct for any gripper with no
-- measurement step. Until the span is meaningful, fall back to the fixed percentage.
function DragonArm.jawFraction(self, grip: number?): number
	if grip == nil then
		return 0
	end
	self.gripLo = self.gripLo and math.min(self.gripLo, grip) or grip
	self.gripHi = self.gripHi and math.max(self.gripHi, grip) or grip
	local span = (self.gripHi :: number) - (self.gripLo :: number)
	if span >= ArenaConfig.GRIP_SPAN_MIN then
		return math.clamp((grip - (self.gripLo :: number)) / span, 0, 1)
	end
	return math.clamp(grip / ArenaConfig.GRIP_OPEN_PCT, 0, 1)
end

-- The raw gripper reading the jaw fraction was computed from. AttackDetect needs both: the
-- fraction for "is this jaw open for this arm", the raw percent for the butterfingers floor.
function DragonArm.gripSpan(self): (number?, number?)
	return self.gripLo, self.gripHi
end

-- The normal of the plane through shoulder_lift, elbow_flex and wrist_flex. This is "up" for every
-- segment, so the spikes stay on top however the arm is pointing. Undefined when those three are
-- collinear (a straight arm), and the previous frame's value is kept rather than snapping.
function DragonArm.planeNormal(self, pts: { Vector3 }): Vector3
	if #pts < 4 then
		return self.normal
	end
	local n = (pts[3] - pts[2]):Cross(pts[4] - pts[3])
	if n.Magnitude < 1e-3 then
		return self.normal                 -- arm straight: the plane is undefined, keep the last
	end
	self.normal = n.Unit
	return self.normal
end

-- ---------------------------------------------------------------------------------------------
-- Building. Everything below runs once, on the first frame that carries a full set of points.
-- ---------------------------------------------------------------------------------------------

-- A segment is a Model whose parts are laid out in local space: the core runs along +Z, centred at
-- the origin, so the Model's pivot is the segment's midpoint and PivotTo(CFrame.lookAt(mid, b, up))
-- puts it exactly on the arm.
function DragonArm.buildSegment(self, i: number, span: number): any
	local spec = SEGMENTS[i]
	local t = spec.thickness
	local model = Instance.new("Model")
	model.Name = spec.name
	model.Parent = self.model

	-- The core is the hitbox, and the only part in the dragon that answers a query. Everything
	-- else hangs off it as decoration.
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = true                  -- this is what GetPartsInPart finds
	core.CanTouch = false
	core.CastShadow = true
	core.Material = Enum.Material.SmoothPlastic
	core.Color = C.DragonScale
	core.Size = Vector3.new(t, t * 0.85, span)
	core.TopSurface = Enum.SurfaceType.Smooth
	core.BottomSurface = Enum.SurfaceType.Smooth
	core.Parent = model
	model.PrimaryPart = core

	local seg = { model = model, core = core, length = span, spec = spec, parts = {} }

	-- Underside, so the silhouette has a dark belly under the lit plates.
	local belly = decor(model, "Belly", C.DragonShade, Vector3.new(t * 0.92, t * 0.3, span * 0.98))
	seg.belly = belly

	-- Overlapping armour plates along the top. Chunky and smooth, Roblox plastic, not texture.
	seg.plates = {}
	for k = 1, spec.plates do
		local f = (k - 0.5) / spec.plates
		local plate = decor(model, "Plate" .. k, C.DragonScale,
			Vector3.new(t * 1.06, t * 0.34, span / spec.plates * 1.15))
		seg.plates[k] = { part = plate, z = (f - 0.5) * span, y = t * 0.4 }
	end

	-- A row of spikes along the top: half of what makes the silhouette unmistakable against the
	-- sky (the horns are the other half).
	seg.spikes = {}
	for k = 1, spec.spikes do
		local f = (k - 0.5) / spec.spikes
		local spike = decor(model, "Spike" .. k, C.DragonSpike,
			Vector3.new(t * 0.22, t * 0.62, t * 0.3))
		spike.Shape = Enum.PartType.Wedge
		seg.spikes[k] = { part = spike, z = (f - 0.5) * span, y = t * 0.62 }
	end

	return seg
end

-- The head: a wedge longer than it is wide. The upper jaw is fixed to the skull; the lower jaw is
-- hinged at the *back* of the head and swings open with the gripper.
function DragonArm.buildHead(self, seg: any)
	local t = seg.spec.thickness
	local span = seg.length
	local model = seg.model

	seg.core.Size = Vector3.new(t, t * 0.78, span)
	seg.core.Transparency = 1          -- the jaws are the visible head; the core is just the hitbox

	local upper = decor(model, "UpperJaw", C.DragonScale, Vector3.new(t, t * 0.42, span))
	seg.upper = upper

	local lower = decor(model, "LowerJaw", C.DragonShade, Vector3.new(t * 0.9, t * 0.34, span * 0.92))
	seg.lower = lower
	seg.hingeZ = -span / 2 + t * 0.1   -- back of the head, so the jaw opens downward and forward

	-- The mouth glows more as the jaw opens. Mostly transparent when shut, so a closed dragon is
	-- not a lamp.
	local maw = decor(model, "Maw", C.DragonEye, Vector3.new(t * 0.72, t * 0.3, span * 0.8),
		Enum.Material.Neon)
	maw.Transparency = 1
	seg.maw = maw

	local light = Instance.new("PointLight")
	light.Name = "MouthLight"
	light.Color = C.Lava
	light.Range = 30
	light.Brightness = 0
	light.Enabled = false
	light.Parent = maw
	seg.mouthLight = light

	-- Where the fire comes from, pointing along the head's forward axis (wrist_roll -> tip).
	local mouth = Instance.new("Attachment")
	mouth.Name = "Mouth"
	mouth.CFrame = CFrame.new(0, 0, span / 2)
	mouth.Parent = seg.core
	seg.mouth = mouth

	seg.eyes = {}
	for k = -1, 1, 2 do
		local eye = decor(model, "Eye" .. (k < 0 and "L" or "R"), C.DragonEye,
			Vector3.new(t * 0.2, t * 0.2, t * 0.2), Enum.Material.Neon)
		eye.Shape = Enum.PartType.Ball
		table.insert(seg.eyes, { part = eye, x = k * t * 0.32, y = t * 0.24, z = span * 0.16 })
	end

	seg.teeth = {}
	for k = 1, 6 do
		local side = (k % 2 == 0) and 1 or -1
		local f = math.ceil(k / 2) / 3.5
		local tooth = decor(model, "Tooth" .. k, C.DragonTooth,
			Vector3.new(t * 0.09, t * 0.16, t * 0.12))
		table.insert(seg.teeth, { part = tooth, x = side * t * 0.34, z = span * (0.5 - f * 0.4) })
	end

	seg.horns = {}
	for k = -1, 1, 2 do
		local horn = decor(model, "Horn" .. (k < 0 and "L" or "R"), C.DragonSpike,
			Vector3.new(t * 0.18, t * 0.9, t * 0.26))
		horn.Shape = Enum.PartType.Wedge
		table.insert(seg.horns, { part = horn, x = k * t * 0.3, y = t * 0.5, z = -span * 0.34 })
	end
end

-- An iron ring with bolts at every joint. This is where the machine shows through the dragon, and
-- it is the detail that keeps the neck from reading as the smooth serpent the concept art shows.
function DragonArm.buildJoint(self, i: number, diameter: number): Model
	local model = Instance.new("Model")
	model.Name = "Joint" .. i
	model.Parent = self.model

	local ring = decor(model, "Ring", C.DragonIron,
		Vector3.new(diameter, diameter * 0.3, diameter), Enum.Material.DiamondPlate)
	ring.Shape = Enum.PartType.Cylinder
	model.PrimaryPart = ring

	for k = 1, 4 do
		local a = (k / 4) * math.pi * 2
		local bolt = decor(model, "Bolt" .. k, C.DragonIron,
			Vector3.new(diameter * 0.11, diameter * 0.11, diameter * 0.11), Enum.Material.Metal)
		bolt:SetAttribute("OffsetY", math.cos(a) * diameter * 0.46)
		bolt:SetAttribute("OffsetZ", math.sin(a) * diameter * 0.46)
	end
	return model
end

-- The base point sits on a wide bolted iron drum, sunk into rock, with Neon cracks around its foot.
function DragonArm.buildPedestal(self, base: Vector3, diameter: number)
	local model = Instance.new("Model")
	model.Name = "Pedestal"
	model.Parent = self.model

	local drum = decor(model, "Drum", C.DragonIron,
		Vector3.new(diameter * 1.5, diameter * 1.1, diameter * 1.5), Enum.Material.DiamondPlate)
	drum.Shape = Enum.PartType.Cylinder
	drum.CFrame = CFrame.new(base - Vector3.new(0, diameter * 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2)

	for k = 1, 6 do
		local a = (k / 6) * math.pi * 2
		local bolt = decor(model, "Bolt" .. k, C.DragonIron,
			Vector3.new(diameter * 0.14, diameter * 0.14, diameter * 0.14), Enum.Material.Metal)
		bolt.CFrame = CFrame.new(base
			+ Vector3.new(math.cos(a) * diameter * 0.72, -diameter * 0.1, math.sin(a) * diameter * 0.72))
	end

	for k = 1, 4 do
		local a = (k / 4) * math.pi * 2 + 0.4
		local crack = decor(model, "Crack" .. k, C.Ember,
			Vector3.new(diameter * 0.12, 0.2, diameter * 0.9), Enum.Material.Neon)
		crack.Transparency = 0.35
		crack.CFrame = CFrame.new(base
			+ Vector3.new(math.cos(a) * diameter, -diameter * 1.02, math.sin(a) * diameter))
			* CFrame.Angles(0, -a, 0)
	end
	self.pedestal = model
end

function DragonArm.build(self, pts: { Vector3 })
	for i = 1, math.min(#pts - 1, #SEGMENTS) do
		local span = (pts[i + 1] - pts[i]).Magnitude
		local seg = self:buildSegment(i, span)
		if i == HEAD_INDEX then
			self:buildHead(seg)
		end
		self.segments[i] = seg
	end
	for i = 1, #pts do
		local d = (SEGMENTS[math.min(i, #SEGMENTS)].thickness) * 1.18
		self.joints[i] = self:buildJoint(i, d)
	end
	self:buildPedestal(pts[1], SEGMENTS[1].thickness)
	self.built = true
end

-- ---------------------------------------------------------------------------------------------
-- Moving. Every frame, no interpolation.
-- ---------------------------------------------------------------------------------------------

function DragonArm.placeSegment(self, i: number, a: Vector3, b: Vector3, up: Vector3, roll: number)
	local seg = self.segments[i]
	if not seg then
		return
	end
	local dir = b - a
	if dir.Magnitude < 1e-3 then
		return
	end
	-- lookAt orthogonalises `up` against the look direction. The plane normal is already
	-- perpendicular to every segment, so nothing is lost - but a segment exactly along the normal
	-- would be ambiguous, which is why the normal is a *plane* normal and not an arbitrary axis.
	local base = CFrame.lookAt((a + b) / 2, b, up)
	if roll ~= 0 then
		base = base * CFrame.Angles(0, 0, roll)
	end
	seg.model:PivotTo(base)

	local t = seg.spec.thickness
	-- Decorations are positioned from the model's pivot each frame rather than welded, so a part
	-- destroyed by anything else recovers on the next frame instead of leaving a hole.
	seg.belly.CFrame = base * CFrame.new(0, -t * 0.32, 0)
	for _, pl in seg.plates do
		pl.part.CFrame = base * CFrame.new(0, pl.y, pl.z)
	end
	for _, sp in seg.spikes do
		sp.part.CFrame = base * CFrame.new(0, sp.y, sp.z) * CFrame.Angles(-math.pi / 2, 0, 0)
	end

	if i == HEAD_INDEX then
		self:placeHead(seg, base)
	end
end

function DragonArm.placeHead(self, seg: any, base: CFrame)
	local t = seg.spec.thickness
	local span = seg.length

	seg.upper.CFrame = base * CFrame.new(0, t * 0.2, 0)

	-- The lower jaw swings about the hinge at the back of the head. Rotating about the hinge, not
	-- about the jaw's own centre, is what makes it read as a jaw rather than a sliding plate.
	local angle = math.rad(ArenaConfig.JAW_MAX_DEG) * self.jawFrac
	local hinge = base * CFrame.new(0, -t * 0.08, seg.hingeZ)
	seg.lower.CFrame = hinge * CFrame.Angles(angle, 0, 0) * CFrame.new(0, 0, span * 0.46)

	-- Glow grows with the opening. This shows the arm's *current* state, which hard rule 1 allows -
	-- it is not a wind-up, and it cannot predict where the operator will strike.
	seg.maw.CFrame = hinge * CFrame.Angles(angle / 2, 0, 0) * CFrame.new(0, 0, span * 0.4)
	seg.maw.Transparency = 1 - 0.85 * self.jawFrac
	seg.mouthLight.Enabled = self.jawFrac > 0.05
	seg.mouthLight.Brightness = 3 * self.jawFrac

	for _, e in seg.eyes do
		e.part.CFrame = base * CFrame.new(e.x, e.y, e.z)
	end
	for _, th in seg.teeth do
		th.part.CFrame = base * CFrame.new(th.x, t * 0.04, th.z)
	end
	for _, h in seg.horns do
		h.part.CFrame = base * CFrame.new(h.x, h.y, h.z) * CFrame.Angles(-math.pi / 2.6, 0, 0)
	end
end

function DragonArm.placeJoint(self, i: number, at: Vector3, dir: Vector3, up: Vector3)
	local model = self.joints[i]
	if not model then
		return
	end
	local cf = CFrame.lookAt(at, at + dir, up) * CFrame.Angles(0, math.pi / 2, 0)
	model:PivotTo(cf)
	for _, bolt in model:GetChildren() do
		if bolt:IsA("BasePart") and bolt.Name ~= "Ring" then
			bolt.CFrame = cf * CFrame.new(0,
				bolt:GetAttribute("OffsetY") :: number, bolt:GetAttribute("OffsetZ") :: number)
		end
	end
end

-- Dormant: a stale arm is a harmless dragon (hard rule 5). The body goes to DragonShade, the eyes
-- go out, and AttackDetect stops dealing damage. The dragon does *not* move to a rest pose - it
-- stays exactly where the last real frame put it, because moving it would be animating the dragon
-- locally, and a player standing clear of a dead dragon should not have it drift onto them.
function DragonArm.setDormant(self, dormant: boolean)
	if dormant == self.dormant then
		return
	end
	self.dormant = dormant

	for i, seg in self.segments do
		seg.core.Color = dormant and C.DragonShade or C.DragonScale
		if i ~= HEAD_INDEX then
			for _, pl in seg.plates do
				pl.part.Color = dormant and C.DragonShade or C.DragonScale
			end
		end
	end
	local head = self.segments[HEAD_INDEX]
	if head then
		head.upper.Color = dormant and C.DragonShade or C.DragonScale
		for _, e in head.eyes do
			e.part.Material = dormant and Enum.Material.SmoothPlastic or Enum.Material.Neon
			e.part.Color = dormant and C.DragonSpike or C.DragonEye
		end
		head.maw.Transparency = dormant and 1 or head.maw.Transparency
		head.mouthLight.Enabled = not dormant and head.mouthLight.Enabled
	end
end

function DragonArm.update(self, arm: any, armAge: number?)
	if arm == nil or arm.points == nil or #arm.points < 2 then
		return
	end

	local pts = table.create(#arm.points)
	for i, p in arm.points do
		pts[i] = Mapping.point(p)
	end
	self.points = pts

	if not self.built then
		self:build(pts)
	end

	self.jawFrac = self:jawFraction(arm.joints and arm.joints.gripper)
	local up = self:planeNormal(pts)

	-- Head roll comes from the joint: three points on a line say nothing about rotation about that
	-- line. Check the sign once against the real arm - roll the wrist and confirm the head turns
	-- the same way - and flip it here if it is backwards, not in the mapping.
	local roll = math.rad(arm.joints and arm.joints.wrist_roll or 0)

	for i = 1, math.min(#pts - 1, #self.segments) do
		self:placeSegment(i, pts[i], pts[i + 1], up, i == HEAD_INDEX and roll or 0)
	end
	for i = 1, math.min(#pts, #self.joints) do
		local dir = (i < #pts) and (pts[i + 1] - pts[i]) or (pts[i] - pts[i - 1])
		self:placeJoint(i, pts[i], dir, up)
	end

	self:setDormant((armAge or 0) > ArenaConfig.STALE_ARM_S)
end

-- Where the jaw tips are. The last point, same as arm.tip.
function DragonArm.tip(self): Vector3?
	return self.points[#self.points]
end

function DragonArm.headCFrame(self): CFrame?
	local seg = self.segments[HEAD_INDEX]
	return seg and seg.model:GetPivot() or nil
end

function DragonArm.mouthAttachment(self): Attachment?
	local seg = self.segments[HEAD_INDEX]
	return seg and seg.mouth or nil
end

function DragonArm.isDormant(self): boolean
	return self.dormant
end

-- Overlap against the core segment parts. Anchored, CFrame-driven parts do not fire Touched
-- reliably, so the server checks the overlap itself each Heartbeat - the same approach
-- SkyArm:partsTouching takes. Only the cores are tested, so this is exactly the drawn body and
-- never a hidden radius around it.
function DragonArm.partsTouching(self, params: OverlapParams?): { BasePart }
	local hits, seen = {}, {}
	for _, seg in self.segments do
		for _, hit in workspace:GetPartsInPart(seg.core, params) do
			if not seen[hit] then
				seen[hit] = true
				table.insert(hits, hit)
			end
		end
	end
	return hits
end

return DragonArm
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX14">
				<Properties>
					<string name="Name">AttackDetect</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Works out what the dragon is doing from the arm's own motion, as it happens.
--
-- There is no "attack" message on the wire and there cannot be one: the operator is a person
-- holding a leader arm, and nothing upstream knows they are about to slam. So the server watches
-- successive state frames and decides. This is also why hard rule 1 forbids predictive telegraphs -
-- the game finds out at the same instant the players do.
--
-- TIMING COMES FROM `ts`, NOT FROM HEARTBEAT. Bridge keeps only the newest frame and drops the
-- rest, so the gap between the frames actually seen is not Heartbeat's delta time. Dividing a real
-- position change by the wrong dt invents speed, and invented speed fires slams that never
-- happened. Every velocity here is differentiated from the frame's own `ts`.
--
-- EVERY THRESHOLD IS A GUESS. The numbers in ArenaConfig are starting values from the style guide,
-- not measurements. Log real tip speed in teleop and set them from that - and remember the follower
-- caps its own per-tick movement (`max_relative_target = 10` in robot/arm.py), so its top speed is
-- bounded and a threshold above that can never fire at all.
--
--   local detect = AttackDetect.new()
--   detect.onSlam = function(tipMm, speed) ... end
--   Bridge.onState(function(s) detect:update(s) end)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ArenaConfig = require(ReplicatedStorage.Arena.ArenaConfig)

local AttackDetect = {}
AttackDetect.__index = AttackDetect

function AttackDetect.new()
	local self = setmetatable({}, AttackDetect)
	self.history = {} :: { { x: number, y: number, z: number, ts: number } }
	self.vel = { x = 0, y = 0, z = 0 }
	self.armed = true            -- a slam needs the tip to have lifted since the last one
	self.sweeping = false
	self.firing = false
	self.dormant = false
	self.lastTs = nil :: number?

	-- The jaw's observed range, learned exactly as DragonArm does and for the same reason: what
	-- reading means "open" differs from gripper to gripper.
	self.gripLo = nil :: number?
	self.gripHi = nil :: number?

	-- Hooks. Set whichever matter; an unset one is simply not called.
	self.onSlam = nil :: ((tipMm: any, speed: number) -> ())?
	self.onSweepStart = nil :: ((dir: any) -> ())?
	self.onSweep = nil :: ((tipMm: any, dir: any) -> ())?
	self.onSweepEnd = nil :: (() -> ())?
	self.onFireStart = nil :: ((frac: number) -> ())?
	self.onFire = nil :: ((frac: number) -> ())?
	self.onFireEnd = nil :: (() -> ())?
	return self
end

local function call(fn: any, ...)
	if fn then
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[AttackDetect] handler errored: " .. tostring(err))
		end
	end
end

-- Velocity in mm/s, smoothed across the last few frames so one jittery FK sample cannot read as a
-- slam. A gap longer than VELOCITY_MAX_GAP_S means the link stalled rather than the arm moving
-- fast, so the estimate restarts instead of dividing a large move by a large dt.
function AttackDetect.updateVelocity(self, tip: any, ts: number)
	local h = self.history
	local last = h[#h]
	if last and ts - last.ts > ArenaConfig.VELOCITY_MAX_GAP_S then
		table.clear(h)
		self.vel = { x = 0, y = 0, z = 0 }
	end
	if last and ts <= last.ts then
		return                   -- a repeated or out-of-order frame carries no new motion
	end

	table.insert(h, { x = tip.x, y = tip.y, z = tip.z, ts = ts })
	while #h > ArenaConfig.VELOCITY_SMOOTH_FRAMES + 1 do
		table.remove(h, 1)
	end
	if #h < 2 then
		return
	end
	local a, b = h[1], h[#h]
	local dt = b.ts - a.ts
	if dt <= 0 then
		return
	end
	self.vel = { x = (b.x - a.x) / dt, y = (b.y - a.y) / dt, z = (b.z - a.z) / dt }
end

-- Jaw opening 0..1 on this gripper's own learned range. Same method as bridge/world.py
-- `_grip_state` and DragonArm:jawFraction.
function AttackDetect.jawFraction(self, grip: number?): number
	if grip == nil then
		return 0
	end
	self.gripLo = self.gripLo and math.min(self.gripLo, grip) or grip
	self.gripHi = self.gripHi and math.max(self.gripHi, grip) or grip
	local span = (self.gripHi :: number) - (self.gripLo :: number)
	if span >= ArenaConfig.GRIP_SPAN_MIN then
		return math.clamp((grip - (self.gripLo :: number)) / span, 0, 1)
	end
	return math.clamp(grip / ArenaConfig.GRIP_OPEN_PCT, 0, 1)
end

function AttackDetect.stopAll(self)
	if self.sweeping then
		self.sweeping = false
		call(self.onSweepEnd)
	end
	if self.firing then
		self.firing = false
		call(self.onFireEnd)
	end
end

function AttackDetect.update(self, state: any)
	local arm = state and state.arm
	if arm == nil or arm.tip == nil then
		return
	end

	-- A stale arm is a harmless dragon (hard rule 5). Stop whatever was running: a fire cone left
	-- burning on a dead link would keep killing players with nobody driving it.
	if (state.arm_age or 0) > ArenaConfig.STALE_ARM_S then
		if not self.dormant then
			self.dormant = true
			self:stopAll()
			table.clear(self.history)
		end
		return
	end
	self.dormant = false

	local ts = state.ts or os.clock()
	self:updateVelocity(arm.tip, ts)

	local floor = ArenaConfig.ARENA_FLOOR_MM
	local height = arm.tip.z - floor          -- how far the real tip is above the arena floor
	local v = self.vel

	self:detectSlam(arm.tip, height, v)
	self:detectSweep(arm.tip, height, v)
	self:detectFire(arm.joints and arm.joints.gripper)
end

-- The tip comes within SLAM_HEIGHT_MM of the arena floor while moving down fast. One slam per
-- descent: without the re-arm, a tip resting near the floor with a little jitter re-triggers every
-- frame and the arena fills with shockwaves.
--
-- `z` is up off the paper, so descending is a negative z velocity.
function AttackDetect.detectSlam(self, tip: any, height: number, v: any)
	if height > ArenaConfig.SLAM_REARM_MM then
		self.armed = true
		return
	end
	if not self.armed then
		return
	end
	if height <= ArenaConfig.SLAM_HEIGHT_MM and -v.z >= ArenaConfig.SLAM_SPEED_MMS then
		self.armed = false
		call(self.onSlam, tip, -v.z)
	end
end

-- The tip is low and moving sideways fast. Sideways is the x/y plane of the sheet; the vertical
-- component is deliberately excluded, or a fast slam would also register as a sweep.
function AttackDetect.detectSweep(self, tip: any, height: number, v: any)
	local lateral = math.sqrt(v.x * v.x + v.y * v.y)
	local low = height <= ArenaConfig.SWEEP_HEIGHT_MM
	local fast = lateral >= ArenaConfig.SWEEP_SPEED_MMS
	local dir = { x = v.x, y = v.y, speed = lateral }

	if low and fast then
		if not self.sweeping then
			self.sweeping = true
			call(self.onSweepStart, dir)
		end
		call(self.onSweep, tip, dir)
	elseif self.sweeping then
		self.sweeping = false
		call(self.onSweepEnd)
	end
end

-- Fire needs BOTH tests, and the second one is the whole point.
--
-- `butterfingers` holds the jaw at least 18% open for its whole duration (BUTTERFINGERS_OPEN_PCT
-- in bridge/effects.py). On the learned range alone a jaw jammed that far open can read as a roar,
-- so a player spending a power-up to jam the dragon's jaw would instead hand it 8 seconds of free
-- fire. The absolute floor, set safely above 18, is what stops that - and it has to be an absolute
-- reading, because the learned range is exactly what the debuff distorts.
function AttackDetect.detectFire(self, grip: number?)
	local frac = self:jawFraction(grip)
	local openEnough = frac >= ArenaConfig.FIRE_OPEN_FRAC
	local aboveJamFloor = (grip or 0) >= ArenaConfig.FIRE_MIN_PCT

	if openEnough and aboveJamFloor then
		if not self.firing then
			self.firing = true
			call(self.onFireStart, frac)
		end
		call(self.onFire, frac)
	elseif self.firing then
		-- Stops on the same frame the jaw drops below the threshold: a fire cone that lingers is a
		-- hit volume the player cannot see.
		self.firing = false
		call(self.onFireEnd)
	end
end

return AttackDetect
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX15">
				<Properties>
					<string name="Name">AttackFx</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- What a slam, a sweep and a fire breath look like - and what they hit.
--
-- WHAT YOU SEE IS WHAT HITS (hard rule 3). Every hit volume in this file is the drawn thing: the
-- shockwave ring is tested at the radius the ring has actually grown to on that frame, and the
-- fire cone is tested at the FIRE_RANGE and FIRE_HALF_ANGLE the particles are emitted into. There
-- is no generous hidden radius anywhere. If you widen a cone, widen the particles with it.
--
-- NOTHING HERE MOVES THE DRAGON. These are effects *around* the dragon, parented to the world or
-- to the head, never offsets applied to the rig. The dragon's position is DragonArm's business and
-- comes only from arm.points.
--
--   local fx = AttackFx.new(workspace, arena, dragon)
--   fx.onHit = function(player, kind) ... end
--   detect.onSlam = function(tip, speed) fx:slam(tip, speed) end

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Arena.Theme)
local ArenaConfig = require(ReplicatedStorage.Arena.ArenaConfig)
local Remotes = require(ReplicatedStorage.Arena.Remotes)
local Mapping = require(script.Parent.Parent.Mapping)

local AttackFx = {}
AttackFx.__index = AttackFx

local C = Theme.Color

local SLAM_FLASH_S = 0.08
local SLAM_RING_S = 0.45
local SWEEP_TRAIL_S = 0.3

function AttackFx.new(parent: Instance, arena: any, dragon: any)
	local self = setmetatable({}, AttackFx)
	self.parent = parent
	self.arena = arena
	self.dragon = dragon
	self.rng = Random.new()
	self.lastHit = {} :: { [Player]: number }     -- HIT_GRACE_S debounce, per player
	self.onHit = nil :: ((player: Player, kind: string) -> ())?
	self.fireParts = nil :: any
	self.sweepParts = nil :: any
	self.lastScorch = 0
	return self
end

-- Alive players with a character on the floor. Everything that deals damage goes through this, so
-- a spectator or a respawning player is never hit.
function AttackFx.targets(self): { { player: Player, root: BasePart } }
	local out = {}
	for _, player in Players:GetPlayers() do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			table.insert(out, { player = player, root = root :: BasePart })
		end
	end
	return out
end

-- A player cannot be hit twice inside HIT_GRACE_S. Without it a sweep running at 30 frames a
-- second registers thirty hits on the same player, and a shockwave and a sweep landing together
-- double up.
function AttackFx.canHit(self, player: Player): boolean
	local last = self.lastHit[player]
	if last and os.clock() - last < ArenaConfig.HIT_GRACE_S then
		return false
	end
	self.lastHit[player] = os.clock()
	return true
end

function AttackFx.hit(self, player: Player, kind: string, knockback: Vector3?)
	if not self:canHit(player) then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and knockback then
		root.AssemblyLinearVelocity = knockback
	end
	if self.onHit then
		local ok, err = pcall(self.onHit, player, kind)
		if not ok then
			warn("[AttackFx] onHit errored: " .. tostring(err))
		end
	end
end

local function fxPart(parent: Instance, name: string, color: Color3, material: Enum.Material,
	size: Vector3, cf: CFrame): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = material
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.Parent = parent
	return p
end

-- ---------------------------------------------------------------------------------------------
-- Slam
-- ---------------------------------------------------------------------------------------------

function AttackFx.slam(self, tipMm: any, speed: number)
	local at = Mapping.point(tipMm)
	local floorY = self.arena:floorY()
	local ground = Vector3.new(at.X, floorY + 0.1, at.Z)

	self:slamFlash(ground)
	self:slamRing(ground)
	self:slamDebris(ground)
	self:slamBurst(ground)
	self:slamShake(ground)
	self.arena:addCrater(ground, ArenaConfig.SLAM_RADIUS * 0.22)
end

function AttackFx.slamFlash(self, ground: Vector3)
	local flash = fxPart(self.parent, "SlamFlash", C.WhiteHot, Enum.Material.Neon,
		Vector3.new(26, 0.4, 26), CFrame.new(ground) * CFrame.Angles(0, 0, math.pi / 2))
	flash.Shape = Enum.PartType.Cylinder
	Debris:AddItem(flash, SLAM_FLASH_S)
end

-- The ring grows from the head's width out to SLAM_RADIUS while fading. Kept low and thin on
-- purpose: it has to look like something a player can jump over, because it is.
--
-- IT IS BUILT AS AN ACTUAL RING, not a disc with a hole painted on. A flat cylinder was the
-- obvious thing and it is wrong here: the hazard is the travelling edge, so a filled disc draws a
-- danger area that is mostly safe. That breaks hard rule 3 in the direction players notice least
-- but trust least too - they learn the middle is survivable and stop believing the drawing.
-- RING_SEGMENTS chunks around the circumference give the same chunky Roblox look, and the hit test
-- below is then the same band the player can see.
local RING_SEGMENTS = 16
local RING_BAND = 5             -- studs either side of the edge; the chunks are this thick

function AttackFx.slamRing(self, ground: Vector3)
	local model = Instance.new("Model")
	model.Name = "Shockwave"
	model.Parent = self.parent

	local chunks = {}
	for k = 1, RING_SEGMENTS do
		local chunk = fxPart(model, "Arc" .. k, C.LavaHot, Enum.Material.Neon,
			Vector3.new(4, 0.8, RING_BAND), CFrame.new(ground))
		chunks[k] = chunk
	end

	task.spawn(function()
		local t0 = os.clock()
		local hitAlready = {} :: { [Player]: boolean }
		local startR, endR = 7, ArenaConfig.SLAM_RADIUS
		while model.Parent do
			local f = (os.clock() - t0) / SLAM_RING_S
			if f >= 1 then
				break
			end
			local r = startR + (endR - startR) * f
			-- Arc width grows with the radius so the ring stays closed as it expands, instead of
			-- opening into sixteen separate flying bricks.
			local arcWidth = (2 * math.pi * r) / RING_SEGMENTS * 1.08
			local colour = C.LavaHot:Lerp(C.Ember, f)
			for k, chunk in chunks do
				local a = (k / RING_SEGMENTS) * math.pi * 2
				chunk.Size = Vector3.new(arcWidth, 0.8, RING_BAND)
				chunk.CFrame = CFrame.new(ground + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
					* CFrame.Angles(0, -a, 0)
				chunk.Transparency = f * 0.9
				chunk.Color = colour
			end

			-- The leading edge is the hazard, and it is exactly the band drawn above. A player who
			-- was standing at the centre and has not moved is not hit: the ring has already passed
			-- them, which is what they can see.
			for _, t in self:targets() do
				if not hitAlready[t.player] then
					local flat = Vector3.new(t.root.Position.X, ground.Y, t.root.Position.Z)
					local d = (flat - ground).Magnitude
					if math.abs(d - r) <= RING_BAND then
						hitAlready[t.player] = true
						local push = flat - ground
						push = (push.Magnitude > 0.1 and push.Unit or Vector3.new(0, 0, 1))
							* ArenaConfig.SLAM_KNOCKBACK + Vector3.new(0, 40, 0)
						self:hit(t.player, "slam", push)
					end
				end
			end
			task.wait()
		end
		model:Destroy()
	end)
end

function AttackFx.slamDebris(self, ground: Vector3)
	for k = 1, self.rng:NextInteger(6, 10) do
		local size = self.rng:NextNumber(1.5, 4)
		local chunk = Instance.new("Part")
		chunk.Name = "Debris" .. k
		chunk.Size = Vector3.new(size, size * 0.8, size * 1.1)
		chunk.Color = C.Basalt
		chunk.Material = Enum.Material.Rock
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.CastShadow = false
		chunk.CFrame = CFrame.new(ground + Vector3.new(
			self.rng:NextNumber(-8, 8), 1, self.rng:NextNumber(-8, 8)))
		chunk.AssemblyLinearVelocity = Vector3.new(
			self.rng:NextNumber(-40, 40), self.rng:NextNumber(40, 80), self.rng:NextNumber(-40, 40))
		chunk.Parent = self.parent
		Debris:AddItem(chunk, 2)
	end
end

-- One-off bursts use Emit(), never a Rate toggled on and off: an emitter left enabled for a frame
-- keeps spitting after the slam and eats the particle budget the fire needs.
function AttackFx.slamBurst(self, ground: Vector3)
	local host = fxPart(self.parent, "SlamBurst", C.Scorch, Enum.Material.Neon,
		Vector3.new(1, 1, 1), CFrame.new(ground))
	host.Transparency = 1

	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(C.Scorch)
	smoke.Size = NumberSequence.new(6, 18)
	smoke.Lifetime = NumberRange.new(0.8, 1.6)
	smoke.Speed = NumberRange.new(14, 30)
	smoke.SpreadAngle = Vector2.new(70, 70)
	smoke.Rate = 0
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Parent = host

	local sparks = Instance.new("ParticleEmitter")
	sparks.Color = ColorSequence.new(C.LavaHot, C.Ember)
	sparks.Size = NumberSequence.new(1.1, 0.2)
	sparks.Lifetime = NumberRange.new(0.4, 0.9)
	sparks.Speed = NumberRange.new(40, 80)
	sparks.SpreadAngle = Vector2.new(60, 60)
	sparks.LightEmission = 1
	sparks.Rate = 0
	sparks.Parent = host

	smoke:Emit(26)
	sparks:Emit(34)
	Debris:AddItem(host, 2)
end

-- Camera shake is the one effect that touches the player's screen, and it is the dragon's doing,
-- not a player's. Debuff visuals never shake a player camera (style guide section 8): the players
-- caused those, so punishing their screens for landing one is backwards.
function AttackFx.slamShake(self, ground: Vector3)
	local maxDist = ArenaConfig.SLAM_RADIUS * 2
	for _, t in self:targets() do
		local d = (t.root.Position - ground).Magnitude
		if d < maxDist then
			local strength = 1 - d / maxDist
			Remotes.Shake:FireClient(t.player, strength, math.min(0.4, 0.2 + strength * 0.2))
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- Sweep
-- ---------------------------------------------------------------------------------------------

function AttackFx.sweepStart(self)
	if self.sweepParts then
		return
	end
	local head = self.dragon.segments and self.dragon.segments[5]
	local neck = self.dragon.segments and self.dragon.segments[3]
	if not head then
		return
	end

	-- Trails only on the head and the upper neck (the performance budget). A trail per segment
	-- reads as a smear and costs five times as much.
	local trails = {}
	for _, seg in { head, neck } do
		if seg then
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, seg.spec.thickness * 0.4, 0)
			a0.Parent = seg.core
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -seg.spec.thickness * 0.4, 0)
			a1.Parent = seg.core

			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Color = ColorSequence.new(C.Ember)
			trail.Transparency = NumberSequence.new(0.2, 1)
			trail.Lifetime = SWEEP_TRAIL_S
			trail.LightEmission = 0.6
			trail.Parent = seg.core
			table.insert(trails, { trail = trail, a0 = a0, a1 = a1 })
		end
	end

	-- Sparks where the tip scrapes the ground.
	local sparkHost = fxPart(self.parent, "SweepSparks", C.LavaHot, Enum.Material.Neon,
		Vector3.new(1, 1, 1), CFrame.new(0, 0, 0))
	sparkHost.Transparency = 1
	local sparks = Instance.new("ParticleEmitter")
	sparks.Color = ColorSequence.new(C.LavaHot, C.Ember)
	sparks.Size = NumberSequence.new(0.9, 0.1)
	sparks.Lifetime = NumberRange.new(0.3, 0.6)
	sparks.Speed = NumberRange.new(20, 50)
	sparks.SpreadAngle = Vector2.new(50, 50)
	sparks.LightEmission = 1
	sparks.Rate = 90
	sparks.Parent = sparkHost

	local dust = Instance.new("ParticleEmitter")
	dust.Color = ColorSequence.new(C.Scorch)
	dust.Size = NumberSequence.new(4, 12)
	dust.Lifetime = NumberRange.new(0.5, 1)
	dust.Speed = NumberRange.new(6, 16)
	dust.SpreadAngle = Vector2.new(60, 60)
	dust.Rate = 30
	dust.Transparency = NumberSequence.new(0.5, 1)
	dust.Parent = sparkHost

	self.sweepParts = { trails = trails, sparkHost = sparkHost }
end

function AttackFx.sweep(self, tipMm: any, dir: any)
	if not self.sweepParts then
		return
	end
	local at = Mapping.point(tipMm)
	self.sweepParts.sparkHost.CFrame = CFrame.new(at)

	-- The hit volume for a sweep is the dragon's own body, tested as overlap against the core
	-- segment parts - exactly the drawn dragon, with no extra reach bolted on.
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.dragon.model, self.arena.model }

	local knock = Vector3.new(dir.x, 0, dir.y)
	knock = (knock.Magnitude > 0.01 and knock.Unit or Vector3.new(0, 0, 1))
		* ArenaConfig.SWEEP_KNOCKBACK + Vector3.new(0, 50, 0)

	for _, hit in self.dragon:partsTouching(params) do
		local char = hit.Parent
		local player = char and Players:GetPlayerFromCharacter(char)
		if player then
			self:hit(player, "sweep", knock)
		end
	end
end

function AttackFx.sweepEnd(self)
	local parts = self.sweepParts
	if not parts then
		return
	end
	self.sweepParts = nil
	for _, t in parts.trails do
		t.trail.Enabled = false
		Debris:AddItem(t.trail, SWEEP_TRAIL_S + 0.1)
		Debris:AddItem(t.a0, SWEEP_TRAIL_S + 0.2)
		Debris:AddItem(t.a1, SWEEP_TRAIL_S + 0.2)
	end
	parts.sparkHost:Destroy()
end

-- ---------------------------------------------------------------------------------------------
-- Fire breath
-- ---------------------------------------------------------------------------------------------

function AttackFx.fireStart(self, frac: number)
	if self.fireParts then
		return
	end
	local mouth = self.dragon:mouthAttachment()
	if not mouth then
		return
	end

	local flame = Instance.new("ParticleEmitter")
	flame.Name = "Fire"
	flame.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, C.WhiteHot),
		ColorSequenceKeypoint.new(0.25, C.LavaHot),
		ColorSequenceKeypoint.new(0.55, C.Lava),
		ColorSequenceKeypoint.new(0.8, C.Ember),
		ColorSequenceKeypoint.new(1, C.Scorch),
	})
	flame.Size = NumberSequence.new(3, 20)
	flame.Lifetime = NumberRange.new(0.6, 0.9)
	flame.SpreadAngle = Vector2.new(ArenaConfig.FIRE_HALF_ANGLE, ArenaConfig.FIRE_HALF_ANGLE)
	flame.LightEmission = 1
	flame.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	flame.EmissionDirection = Enum.NormalId.Front
	flame.Parent = mouth

	local light = Instance.new("PointLight")
	light.Color = C.Lava
	light.Range = 30
	light.Brightness = 4
	light.Parent = mouth

	self.fireParts = { flame = flame, light = light, mouth = mouth }
	self:fire(frac)
end

-- Rate and speed grow with how far the jaw is open. This shows the arm's *current* state, which
-- hard rule 1 allows - it is feedback, not a wind-up, and it cannot predict anything.
function AttackFx.fire(self, frac: number)
	local parts = self.fireParts
	if not parts then
		return
	end
	parts.flame.Rate = 60 + 140 * frac
	parts.flame.Speed = NumberRange.new(60 + 20 * frac, 90 + 30 * frac)
	parts.light.Brightness = 3 + 3 * frac
	self:fireHits()
end

-- The hit volume is the drawn cone: FIRE_RANGE long, FIRE_HALF_ANGLE wide, measured from the mouth
-- along the head's forward axis - the same numbers the particles use. A raycast to each candidate
-- means rocks and platforms give real cover, so hiding behind the thing you can see works.
function AttackFx.fireHits(self)
	local parts = self.fireParts
	if not parts then
		return
	end
	local origin = parts.mouth.WorldPosition
	local forward = parts.mouth.WorldCFrame.LookVector
	local cosLimit = math.cos(math.rad(ArenaConfig.FIRE_HALF_ANGLE))

	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { self.dragon.model }

	for _, t in self:targets() do
		local to = t.root.Position - origin
		local dist = to.Magnitude
		if dist <= ArenaConfig.FIRE_RANGE and dist > 0.1 then
			if to.Unit:Dot(forward) >= cosLimit then
				local result = workspace:Raycast(origin, to, rp)
				local blocked = result and not result.Instance:IsDescendantOf(t.root.Parent :: Instance)
				if not blocked then
					self:hit(t.player, "fire")
				end
			end
		end
	end

	-- Scorch where the cone meets the floor, throttled so a long roar does not blow the 20-mark
	-- budget in a second.
	if os.clock() - self.lastScorch > 0.4 then
		local down = workspace:Raycast(origin, forward * ArenaConfig.FIRE_RANGE, rp)
		if down then
			self.lastScorch = os.clock()
			self.arena:addScorch(down.Position, 10)
		end
	end
end

function AttackFx.fireEnd(self)
	local parts = self.fireParts
	if not parts then
		return
	end
	self.fireParts = nil
	parts.flame.Enabled = false
	Debris:AddItem(parts.flame, 1)
	parts.light:Destroy()
end

return AttackFx
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX16">
				<Properties>
					<string name="Name">DragonEffects</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- What the dragon looks like while a player's power-up is running on the real arm.
--
-- EFFECTS COME FROM SERVER STATE (hard rule 4). Every overlay here is driven by `state.effects` -
-- the list Python sends, with the name, intensity and remaining time it actually applied. Not by
-- the button press that asked for it. The server clamps every duration to its own caps
-- (bridge/effects.py LIMITS), so a request for 30 s of freeze becomes 3 s, and a HUD or an overlay
-- that believed the request would sit there showing 27 seconds of a debuff that already ended.
--
-- THE PLAYERS CAUSED THESE, SO THEY NEVER PUNISH THE PLAYERS' SCREENS. No player camera shake, no
-- fog over the player's view, no flipped player screen. plan.md's table describes those for the
-- obby, where the *player* is the one being messed with; in the arena the player is the one doing
-- the messing, so every effect lands on the dragon and on the operator's screen instead.
--
-- OVERLAYS FOLLOW THE DRAGON EXACTLY (hard rule 2). Each one is repositioned from the segment
-- pivots every frame, just as DragonArm's own decorations are. None of them tween the dragon.
-- Under `earthquake` especially: the real arm is already shaking and that shake arrives in
-- arm.points, so the visible wobble is real. Adding any on top would double it.
--
--   local fx = DragonEffects.new(dragon)
--   Bridge.onState(function(s) fx:update(s.effects) end)

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Arena.Theme)

local DragonEffects = {}
DragonEffects.__index = DragonEffects

local C = Theme.Color
local FADE_S = 0.5           -- the overlay fades over the effect's last half second

function DragonEffects.new(dragon: any)
	local self = setmetatable({}, DragonEffects)
	self.dragon = dragon
	self.active = {} :: { [string]: any }    -- effect name -> its overlay parts
	self.folder = Instance.new("Folder")
	self.folder.Name = "DragonEffects"
	self.folder.Parent = dragon.model
	return self
end

local function overlayPart(parent: Instance, name: string, color: Color3, material: Enum.Material,
	size: Vector3): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = material
	p.Color = color
	p.Size = size
	p.Parent = parent
	return p
end

-- ---------------------------------------------------------------------------------------------
-- One builder per effect. Each returns a table with a `parts` list and an optional `follow(alpha)`
-- that repositions it from the dragon each frame. `alpha` is 1 while the effect is running and
-- ramps to 0 over its last half second, so players see it ending rather than blinking out.
-- ---------------------------------------------------------------------------------------------

local Builders = {}

-- SHAKE: aqua arcs jumping between the joint rings, sparks off the plates. The wobble itself is
-- the real arm's, already in arm.points. Nothing here moves anything.
function Builders.earthquake(self)
	local arcs = {}
	for i = 1, math.max(#self.dragon.joints - 1, 0) do
		local arc = overlayPart(self.folder, "Arc" .. i, C.Shake, Enum.Material.Neon,
			Vector3.new(0.8, 0.8, 1))
		arc.Transparency = 0.2
		table.insert(arcs, arc)
	end
	local sparkHost = overlayPart(self.folder, "QuakeSparks", C.Shake, Enum.Material.Neon,
		Vector3.new(1, 1, 1))
	sparkHost.Transparency = 1
	local sparks = Instance.new("ParticleEmitter")
	sparks.Color = ColorSequence.new(C.Shake)
	sparks.Size = NumberSequence.new(0.8, 0.1)
	sparks.Lifetime = NumberRange.new(0.2, 0.5)
	sparks.Speed = NumberRange.new(15, 40)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.LightEmission = 1
	sparks.Rate = 40
	sparks.Parent = sparkHost

	return {
		parts = { sparkHost, table.unpack(arcs) },
		follow = function(alpha: number)
			local pts = self.dragon.points
			for i, arc in arcs do
				if pts[i] and pts[i + 1] then
					local a, b = pts[i], pts[i + 1]
					-- The arc flickers between the rings rather than sitting solid, so it reads as
					-- electricity instead of a painted stripe.
					local jitter = math.sin(os.clock() * 37 + i) * 0.5 + 0.5
					arc.Size = Vector3.new(0.8, 0.8, (b - a).Magnitude)
					arc.CFrame = CFrame.lookAt((a + b) / 2, b)
					arc.Transparency = 1 - alpha * (0.35 + 0.45 * jitter)
				else
					arc.Transparency = 1
				end
			end
			local head = self.dragon:headCFrame()
			if head then
				sparkHost.CFrame = head
			end
			sparks.Rate = 40 * alpha
		end,
	}
end

-- SLOWED: an indigo ForceField sleeve around the neck with slow drifting particles. ForceField is
-- the one material that reads as "something is wrapped around this" without hiding the armour.
function Builders.molasses(self)
	local sleeves = {}
	for i = 2, 4 do
		local seg = self.dragon.segments[i]
		if seg then
			local t = seg.spec.thickness
			local sleeve = overlayPart(self.folder, "Sleeve" .. i, C.Slow,
				Enum.Material.ForceField, Vector3.new(t * 1.3, t * 1.2, seg.length * 1.02))
			sleeve.Transparency = 0.35
			table.insert(sleeves, { part = sleeve, seg = seg })
		end
	end
	local host = overlayPart(self.folder, "SlowMotes", C.Slow, Enum.Material.Neon, Vector3.new(1, 1, 1))
	host.Transparency = 1
	local motes = Instance.new("ParticleEmitter")
	motes.Color = ColorSequence.new(C.Slow)
	motes.Size = NumberSequence.new(1.6)
	motes.Lifetime = NumberRange.new(1.5, 2.5)
	motes.Speed = NumberRange.new(1, 4)
	motes.SpreadAngle = Vector2.new(180, 180)
	motes.LightEmission = 0.8
	motes.Rate = 18
	motes.Transparency = NumberSequence.new(0.3, 1)
	motes.Parent = host

	return {
		parts = { host, table.unpack((function()
			local list = {}
			for _, s in sleeves do table.insert(list, s.part) end
			return list
		end)()) },
		follow = function(alpha: number)
			for _, s in sleeves do
				s.part.CFrame = s.seg.model:GetPivot()
				s.part.Transparency = 1 - alpha * 0.65
			end
			local head = self.dragon:headCFrame()
			if head then
				host.CFrame = head
			end
			motes.Rate = 18 * alpha
		end,
	}
end

-- INVERTED: a magenta Neon overlay flickering on the segments a few times a second. Glitchy on
-- purpose - the operator's controls are mirrored, and the dragon should look like it is arguing
-- with itself.
function Builders.mirror(self)
	local shells = {}
	for i, seg in self.dragon.segments do
		local t = seg.spec.thickness
		local shell = overlayPart(self.folder, "Glitch" .. i, C.Inverted, Enum.Material.Neon,
			Vector3.new(t * 1.12, t * 0.98, seg.length * 1.01))
		shell.Transparency = 1
		table.insert(shells, { part = shell, seg = seg })
	end
	return {
		parts = (function()
			local list = {}
			for _, s in shells do table.insert(list, s.part) end
			return list
		end)(),
		follow = function(alpha: number)
			-- About 6 flashes a second, each a few frames long.
			local on = (math.floor(os.clock() * 6) % 2) == 0
			for _, s in shells do
				s.part.CFrame = s.seg.model:GetPivot()
				s.part.Transparency = on and (1 - alpha * 0.55) or 1
			end
		end,
	}
end

-- FROZEN: the plates turn to Ice, with shards on the joints, and a shatter burst when it ends.
-- The real arm is holding its pose and ignoring the leader, so a dragon that looks stuck is honest.
function Builders.freeze(self)
	local shells, shards = {}, {}
	for i, seg in self.dragon.segments do
		local t = seg.spec.thickness
		local shell = overlayPart(self.folder, "Ice" .. i, C.Frozen, Enum.Material.Ice,
			Vector3.new(t * 1.16, t * 1.02, seg.length * 1.02))
		shell.Transparency = 0.3
		table.insert(shells, { part = shell, seg = seg })
	end
	for i = 1, #self.dragon.joints do
		for k = 1, 3 do
			local shard = overlayPart(self.folder, "Shard" .. i .. "_" .. k, C.Frozen,
				Enum.Material.Ice, Vector3.new(1.2, 4.5, 1.2))
			shard.Transparency = 0.15
			table.insert(shards, { part = shard, joint = i, k = k })
		end
	end
	return {
		parts = (function()
			local list = {}
			for _, s in shells do table.insert(list, s.part) end
			for _, s in shards do table.insert(list, s.part) end
			return list
		end)(),
		follow = function(alpha: number)
			for _, s in shells do
				s.part.CFrame = s.seg.model:GetPivot()
				s.part.Transparency = 1 - alpha * 0.7
			end
			local pts = self.dragon.points
			for _, s in shards do
				local at = pts[s.joint]
				if at then
					local a = (s.k / 3) * math.pi * 2
					s.part.CFrame = CFrame.new(at + Vector3.new(math.cos(a) * 7, 3, math.sin(a) * 7))
						* CFrame.Angles(math.rad(20), a, 0)
					s.part.Transparency = 1 - alpha * 0.85
				end
			end
		end,
		-- A shatter when it ends: the follower snaps to catch up with the leader after a freeze
		-- (PROTOCOL.md), so the moment is worth marking.
		finish = function()
			local tip = self.dragon:tip()
			if not tip then
				return
			end
			local host = overlayPart(self.folder, "Shatter", C.Frozen, Enum.Material.Neon,
				Vector3.new(1, 1, 1))
			host.Transparency = 1
			host.CFrame = CFrame.new(tip)
			host.Parent = workspace
			local burst = Instance.new("ParticleEmitter")
			burst.Color = ColorSequence.new(C.Frozen)
			burst.Size = NumberSequence.new(2.2, 0.2)
			burst.Lifetime = NumberRange.new(0.5, 1)
			burst.Speed = NumberRange.new(30, 70)
			burst.SpreadAngle = Vector2.new(180, 180)
			burst.LightEmission = 0.9
			burst.Rate = 0
			burst.Parent = host
			burst:Emit(40)
			Debris:AddItem(host, 1.5)
		end,
	}
end

-- LAGGING: thick smoke wraps the head and the eyes dim. The real follower is running up to 800 ms
-- behind the leader, so a half-blind dragon is the right read.
function Builders.fog(self)
	local host = overlayPart(self.folder, "FogHead", C.Lag, Enum.Material.Neon, Vector3.new(1, 1, 1))
	host.Transparency = 1
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(C.Lag)
	smoke.Size = NumberSequence.new(14, 26)
	smoke.Lifetime = NumberRange.new(1.2, 2.2)
	smoke.Speed = NumberRange.new(2, 7)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Rate = 26
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Parent = host

	local head = self.dragon.segments[5]
	return {
		parts = { host },
		follow = function(alpha: number)
			local cf = self.dragon:headCFrame()
			if cf then
				host.CFrame = cf
			end
			smoke.Rate = 26 * alpha
			if head then
				for _, e in head.eyes do
					-- Dim, not off: off is the dormant look, and a lagging dragon is still alive.
					e.part.Transparency = 0.55 * alpha
				end
			end
		end,
		finish = function()
			if head then
				for _, e in head.eyes do
					e.part.Transparency = 0
				end
			end
		end,
	}
end

-- JAW JAMMED: a lime-glowing boulder stuck in the jaw, so the lower jaw cannot fully close. The
-- real gripper is held at least 18% open, which is also exactly why AttackDetect keeps an absolute
-- floor under fire - this must never read as a roar.
function Builders.butterfingers(self)
	local head = self.dragon.segments[5]
	local t = head and head.spec.thickness or 12
	local rock = overlayPart(self.folder, "JamRock", C.Basalt, Enum.Material.Rock,
		Vector3.new(t * 0.6, t * 0.6, t * 0.6))
	local vein = overlayPart(self.folder, "JamVein", C.Jammed, Enum.Material.Neon,
		Vector3.new(t * 0.64, t * 0.16, t * 0.64))
	vein.Transparency = 0.1
	local light = Instance.new("PointLight")
	light.Color = C.Jammed
	light.Range = 14
	light.Brightness = 2
	light.Parent = vein

	return {
		parts = { rock, vein },
		follow = function(alpha: number)
			local cf = self.dragon:headCFrame()
			if cf then
				local at = cf * CFrame.new(0, -t * 0.25, (head and head.length or 20) * 0.22)
				rock.CFrame = at
				vein.CFrame = at
			end
			rock.Transparency = 1 - alpha
			vein.Transparency = 1 - alpha * 0.9
			light.Brightness = 2 * alpha
		end,
	}
end

-- ---------------------------------------------------------------------------------------------

function DragonEffects.start(self, name: string)
	local builder = Builders[name]
	if not builder then
		return nil      -- an effect nobody has themed yet simply has no overlay, which is correct
	end                 -- and visible in the HUD chips regardless
	local ok, overlay = pcall(builder, self)
	if not ok then
		warn("[DragonEffects] could not build " .. name .. ": " .. tostring(overlay))
		return nil
	end
	return overlay
end

function DragonEffects.stop(self, name: string)
	local overlay = self.active[name]
	if not overlay then
		return
	end
	self.active[name] = nil
	if overlay.finish then
		pcall(overlay.finish)
	end
	for _, p in overlay.parts do
		p:Destroy()
	end
end

-- `effects` is state.effects: a list of { name, intensity, remaining }. Several can stack, and an
-- effect missing from the list this frame has ended - the server is the only thing that decides
-- when, so nothing here runs its own timer.
function DragonEffects.update(self, effects: { any }?)
	local seen = {}
	for _, e in (effects or {}) do
		local name = e.name
		if name then
			seen[name] = true
			if not self.active[name] then
				local overlay = self:start(name)
				if overlay then
					self.active[name] = overlay
				end
			end
			local overlay = self.active[name]
			if overlay and overlay.follow then
				-- Fade over the last half second so the effect visibly runs out rather than
				-- vanishing between frames.
				local remaining = e.remaining or 1
				local alpha = math.clamp(remaining / FADE_S, 0, 1)
				pcall(overlay.follow, alpha)
			end
		end
	end

	-- Collected first, then stopped. `stop` clears the entry it is given, and removing keys from a
	-- table that is mid-generalized-iteration is not something to rely on.
	local ended = {}
	for name in self.active do
		if not seen[name] then
			table.insert(ended, name)
		end
	end
	for _, name in ended do
		self:stop(name)
	end
end

function DragonEffects.clear(self)
	local names = {}
	for name in self.active do
		table.insert(names, name)
	end
	for _, name in names do
		self:stop(name)
	end
end

return DragonEffects
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17">
				<Properties>
					<string name="Name">Pickups</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The player's half of the loop: crystals spawn on the floor, a player grabs one into an ability
-- slot, and firing that slot sends a real effect to the real arm.
--
-- THE EFFECT LIST IS BUILT FROM `hello.effects`, NOT HARDCODED. That field is the authoritative
-- list of names the server will accept; anything else earns an `error` frame and is ignored. If
-- Python grows a seventh effect, it shows up here with no edit - themed if Theme knows it, and
-- generic `Power` blue if not.
--
-- A PICKUP FILLS A SLOT; THE PLAYER CHOOSES WHEN TO SPEND IT. That is what makes the ability bar
-- in the concept art mean something: a slot holding a picked-up debuff carries that effect's
-- colour on its border, and the player decides whether to burn it now or save it for a worse
-- moment.
--
-- WHAT COMES BACK IS NOT WHAT WAS ASKED FOR. Python clamps intensity and duration to per-effect
-- caps, so this module's request is a request. The HUD shows `state.effects[].remaining`, which is
-- the truth, and never the duration asked for here.
--
--   local pickups = Pickups.new(workspace, arena, bridge)
--   Bridge.onHello(function(h) pickups:setEffects(h.effects) end)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Arena.Theme)
local ArenaConfig = require(ReplicatedStorage.Arena.ArenaConfig)
local Remotes = require(ReplicatedStorage.Arena.Remotes)
local Icons = require(ReplicatedStorage.Arena.Icons)

local Pickups = {}
Pickups.__index = Pickups

local C = Theme.Color

function Pickups.new(parent: Instance, arena: any, bridge: any)
	local self = setmetatable({}, Pickups)
	self.parent = parent
	self.arena = arena
	self.bridge = bridge
	self.rng = Random.new()
	self.folder = Instance.new("Folder")
	self.folder.Name = "Pickups"
	self.folder.Parent = parent

	self.effects = {} :: { string }           -- from hello.effects
	self.alive = {} :: { any }                -- crystals currently on the floor
	-- player -> { held = {index -> effect}, ready = {index -> os.clock() the slot refills} }.
	-- Two tables rather than one with "cd3" string keys mixed into an array: a slot is either
	-- holding something or cooling down, and keeping those separate is what stops freeSlot and
	-- slotView from disagreeing about what an index means.
	self.slots = {} :: { [Player]: { held: { any }, ready: { number } } }
	self.running = false
	self.lastSpawn = 0

	-- Fires when a player lands a debuff, for the toast and the sound.
	self.onLanded = nil :: ((player: Player, name: string) -> ())?

	Remotes.SlotFire.OnServerEvent:Connect(function(player, index)
		self:fireSlot(player, index)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self.slots[player] = nil
	end)
	return self
end

function Pickups.setEffects(self, effects: { string }?)
	self.effects = effects or {}
	print(("[Pickups] %d effects from hello: %s")
		:format(#self.effects, table.concat(self.effects, ", ")))
end

function Pickups.slotsFor(self, player: Player): any
	local s = self.slots[player]
	if not s then
		s = { held = {}, ready = {} }
		self.slots[player] = s
	end
	return s
end

-- What the HUD shows for this player: one entry per slot, empty slots included so the bar keeps
-- its shape.
function Pickups.slotView(self, player: Player): { any }
	local slots = self:slotsFor(player)
	local view = {}
	for i = 1, ArenaConfig.ABILITY_SLOTS do
		local entry = slots.held[i]
		local until_ = slots.ready[i]
		if entry then
			view[i] = {
				name = entry.name,
				label = Theme.effectLabel(entry.name),
				color = Theme.effectColor(entry.name),
				ready = true,
			}
		elseif until_ and os.clock() < until_ then
			view[i] = { cooldown = until_ - os.clock(), ready = false }
		else
			view[i] = { ready = false }
		end
	end
	return view
end

function Pickups.freeSlot(self, player: Player): number?
	local slots = self:slotsFor(player)
	for i = 1, ArenaConfig.ABILITY_SLOTS do
		local until_ = slots.ready[i]
		if not slots.held[i] and (not until_ or os.clock() >= until_) then
			return i
		end
	end
	return nil
end

-- A floating Neon crystal in its effect's colour. Pickups are the second-brightest things on
-- screen after the hazards, which is what makes them worth crossing the arena for.
function Pickups.spawnOne(self)
	if #self.effects == 0 or not self.arena.bounds then
		return
	end
	local name = self.effects[self.rng:NextInteger(1, #self.effects)]
	local color = Theme.effectColor(name)
	local at = self.arena:randomFloorPoint(self.rng)

	local model = Instance.new("Model")
	model.Name = "Pickup_" .. name
	model.Parent = self.folder

	local crystal = Instance.new("Part")
	crystal.Name = "Crystal"
	crystal.Size = Vector3.new(3.4, 4, 3.4)
	crystal.Anchored = true
	crystal.CanCollide = false
	crystal.CanQuery = false
	crystal.CanTouch = true
	crystal.CastShadow = false
	crystal.Material = Enum.Material.Neon
	crystal.Color = color
	crystal.CFrame = CFrame.new(at)
	crystal.Parent = model
	model.PrimaryPart = crystal

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 2
	light.Parent = crystal

	-- A soft glow directly under it, so a crystal is findable from across a dark floor.
	local pool = Instance.new("Part")
	pool.Name = "Glow"
	pool.Size = Vector3.new(7, 0.2, 7)
	pool.Anchored = true
	pool.CanCollide = false
	pool.CanQuery = false
	pool.CanTouch = false
	pool.CastShadow = false
	pool.Material = Enum.Material.Neon
	pool.Color = color
	pool.Transparency = 0.6
	pool.Shape = Enum.PartType.Cylinder
	pool.CFrame = CFrame.new(at.X, self.arena.floorTopY + 0.06, at.Z) * CFrame.Angles(0, 0, math.pi / 2)
	pool.Parent = model

	-- The same icon the HUD slot will show, floating over the crystal. This is what makes a pickup
	-- worth crossing the arena for: you can tell what it is before you commit to the run, and you
	-- recognise it again when it lands in your bar.
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Badge"
	billboard.Size = UDim2.fromOffset(44, 44)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 220
	billboard.Parent = crystal
	Icons.draw(billboard, name, color)

	local entry = { model = model, crystal = crystal, name = name, baseY = at.Y, taken = false }

	crystal.Touched:Connect(function(hit)
		if entry.taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player then
			self:grant(player, entry)
		end
	end)

	table.insert(self.alive, entry)
end

function Pickups.grant(self, player: Player, entry: any)
	local index = self:freeSlot(player)
	if not index then
		return        -- every slot full: the crystal stays for someone who can carry it
	end
	entry.taken = true
	self:slotsFor(player).held[index] = { name = entry.name, at = os.clock() }
	entry.model:Destroy()
	for i, e in self.alive do
		if e == entry then
			table.remove(self.alive, i)
			break
		end
	end
end

-- Spend a slot: send the effect to the real arm.
--
-- The index is re-checked here rather than trusted, because this crosses a RemoteEvent and a
-- client can send any number it likes. The cost of trusting it is a player firing effects they
-- never picked up.
function Pickups.fireSlot(self, player: Player, index: any)
	if type(index) ~= "number" or index < 1 or index > ArenaConfig.ABILITY_SLOTS then
		return
	end
	index = math.floor(index)
	local slots = self:slotsFor(player)
	local entry = slots.held[index]
	if not entry then
		return
	end
	slots.held[index] = nil
	slots.ready[index] = os.clock() + ArenaConfig.ABILITY_COOLDOWN_S

	local req = ArenaConfig.EFFECT_REQUEST[entry.name] or { intensity = 1.0, duration = 3.0 }
	local sent = self.bridge.sendEvent(entry.name, req.intensity, req.duration)
	if not sent then
		-- The link is down. Give the slot back rather than eating the pickup: losing a power-up to
		-- a dropped socket would read as the game cheating.
		slots.held[index] = entry
		slots.ready[index] = nil
		return
	end
	if self.onLanded then
		pcall(self.onLanded, player, entry.name)
	end
end

-- Bob and turn. These are pickups, not the dragon: hard rule 2 governs the dragon's parts only,
-- and a crystal that sits perfectly still is invisible against a busy floor.
function Pickups.step(self, dt: number)
	local t = os.clock()
	for _, e in self.alive do
		if e.crystal.Parent then
			e.crystal.CFrame = CFrame.new(e.crystal.Position.X,
				e.baseY + math.sin(t * 1.6) * 1, e.crystal.Position.Z)
				* CFrame.Angles(0, t * 0.8, math.rad(12))
		end
	end

	if self.running and t - self.lastSpawn >= ArenaConfig.PICKUP_INTERVAL_S
		and #self.alive < ArenaConfig.PICKUP_MAX_ALIVE then
		self.lastSpawn = t
		self:spawnOne()
	end
end

function Pickups.start(self)
	self.running = true
	self.lastSpawn = os.clock() - ArenaConfig.PICKUP_INTERVAL_S + 2
end

function Pickups.stop(self)
	self.running = false
end

function Pickups.clear(self)
	for _, e in self.alive do
		e.model:Destroy()
	end
	table.clear(self.alive)
	table.clear(self.slots)
end

return Pickups
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">Rounds</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The round: countdown, survive the timer, win or get eaten.
--
-- Players still alive when the timer ends win. If nobody is left, the dragon wins. That is the
-- whole rule set, and everything here serves it.
--
-- The HUD payload is assembled in one place (`broadcast`) and pushed to every client on a fixed
-- tick rather than on every state frame. The arm arrives at 30 Hz and the HUD does not need 30
-- updates a second to show a timer and a survivor count - and a per-frame RemoteEvent to twelve
-- clients is a real cost for no visible gain.
--
-- `effects` in that payload comes straight from `state.effects` (hard rule 4), so the chips under
-- the timer count down the server's clamped remaining time, not the duration anyone asked for.

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage.Arena.Theme)
local ArenaConfig = require(ReplicatedStorage.Arena.ArenaConfig)
local Remotes = require(ReplicatedStorage.Arena.Remotes)
local Mapping = require(script.Parent.Parent.Mapping)

-- The operator's aiming aids need to show height against the slam threshold, which is in
-- millimetres. Mapping lives in ServerScriptService and the HUD is a LocalScript, so the converted
-- figure rides along in the payload rather than the client hardcoding a scale that would then
-- silently disagree with Mapping the first time anyone retunes it.
local SLAM_HEIGHT_STUDS = ArenaConfig.SLAM_HEIGHT_MM * Mapping.STUDS_PER_MM

local Rounds = {}
Rounds.__index = Rounds

local C = Theme.Color
local HUD_HZ = 8

function Rounds.new(arena: any, dragon: any, pickups: any)
	local self = setmetatable({}, Rounds)
	self.arena = arena
	self.dragon = dragon
	self.pickups = pickups

	self.state = "Waiting"        -- Waiting | Countdown | Round | Over
	self.endsAt = 0
	self.alive = {} :: { [Player]: boolean }
	-- Players who never take part: the operator, who is watching from overhead and is not a
	-- survivor. Without this they count toward the survivor total and the dragon can never win.
	self.excluded = {} :: { [Player]: boolean }
	self.roundNumber = 0
	self.effects = {} :: { any }  -- the newest state.effects, for the HUD chips
	self.lastHud = 0
	self.onRoundStart = nil :: (() -> ())?
	self.onRoundEnd = nil :: ((survivors: number) -> ())?
	return self
end

-- Whoever is on the aerial view IS the dragon, and the dragon is not one of the people it is
-- trying to kill. So they leave the round entirely: no body on the floor, not counted among the
-- survivors, and not outlined on anyone's screen.
--
-- Without this the dragon was a survivor. The count read one too high all round, and a round where
-- the dragon killed everybody never ended - it sat there with one "survivor" who was the dragon,
-- until the timer ran out and awarded them the win.
function Rounds.setOperator(self, player: Player, on: boolean)
	if on then
		if self.excluded[player] then
			return
		end
		local wasAlive = self.alive[player] == true
		self.excluded[player] = true
		self.alive[player] = nil

		-- Take the body away. Spectating in this mode is the absence of a character, and a dragon
		-- standing on its own arena floor is one more thing for players to trip over.
		local char = player.Character
		if char then
			player.Character = nil
			char:Destroy()
		end

		-- They may have been the last one standing. Becoming the dragon is not a way to survive.
		if wasAlive and self.state == "Round" and #self:aliveList() == 0 then
			self:finish(false)
		end
	else
		if not self.excluded[player] then
			return
		end
		self.excluded[player] = nil
		if self.state == "Round" or self.state == "Countdown" then
			self.alive[player] = false    -- spectate until the next round, as a mid-round joiner
		else
			self.alive[player] = true
			task.spawn(function()
				self:spawnInto(player)
			end)
		end
	end
end

-- Kept for ArenaMain's OPERATOR_NAME path, which assigns the dragon on join.
function Rounds.exclude(self, player: Player)
	self:setOperator(player, true)
end

function Rounds.aliveList(self): { Player }
	local out = {}
	for player, isAlive in self.alive do
		if isAlive and player.Parent then
			table.insert(out, player)
		end
	end
	return out
end

function Rounds.banner(self, text: string, color: Color3, seconds: number?, sub: string?)
	Remotes.Banner:FireAllClients({
		text = text, color = color, seconds = seconds or 2, sub = sub,
	})
end

-- ---------------------------------------------------------------------------------------------

function Rounds.start(self)
	if self.state ~= "Waiting" and self.state ~= "Over" then
		return
	end
	-- No floor, no round. In Studio, PlayerAdded fires the instant you press Play while the
	-- WebSocket is still connecting, so without this the first round starts over empty space:
	-- players fall past FallenPartsDestroyHeight, die, and still count as survivors for the full
	-- two minutes because nothing ever hit them. The state is left at Waiting, so the `hello`
	-- handler's own start() call is what gets the round going once the arena is built.
	if not self.arena.bounds then
		return
	end

	local players = {}
	for _, player in Players:GetPlayers() do
		if not self.excluded[player] then
			table.insert(players, player)
		end
	end
	if #players < ArenaConfig.MIN_PLAYERS then
		return
	end

	self.roundNumber += 1
	self.state = "Countdown"
	table.clear(self.alive)
	for _, player in players do
		self.alive[player] = true
		task.spawn(function()
			self:spawnInto(player)
		end)
	end

	task.spawn(function()
		for n = ArenaConfig.COUNTDOWN_SECONDS, 1, -1 do
			if self.state ~= "Countdown" then
				return
			end
			self:banner(tostring(n), C.UiText, 1)
			task.wait(1)
		end
		if self.state ~= "Countdown" then
			return
		end
		-- The last word is Lava, the only warm colour in the round-flow text: it is the dragon's
		-- cue, not the players'.
		self:banner("SURVIVE!", C.Lava, 1.2)
		self.state = "Round"
		self.endsAt = os.clock() + ArenaConfig.ROUND_SECONDS
		self.pickups:start()
		if self.onRoundStart then
			pcall(self.onRoundStart)
		end
	end)
end

-- Give the player a body and put it on the floor.
--
-- `Players.CharacterAutoLoads` is off (ArenaMain sets it), so this is the only thing that hands
-- out characters. With it on, an eliminated player respawned a few seconds later and walked back
-- into a live arena: not counted as a survivor, immune to being eliminated again because
-- `alive[player]` was already false, but still a solid body the dragon's hit tests could see.
-- Spectating is the absence of a character, which is also why `eliminate` does not reload one.
function Rounds.spawnInto(self, player: Player)
	player:LoadCharacter()
	local char = player.Character or player.CharacterAdded:Wait()
	local root = char:FindFirstChild("HumanoidRootPart")
		or char:WaitForChild("HumanoidRootPart", 5)
	if root and root:IsA("BasePart") and self.arena.bounds then
		root.CFrame = CFrame.new(self.arena:randomFloorPoint(Random.new()) + Vector3.new(0, 4, 0))
	end
end

-- A hit is fatal. The dragon is eight to ten times a player's height; the fantasy is dodging it,
-- not trading blows with it. Making this a health model is a design change, not a visual one.
function Rounds.eliminate(self, player: Player, cause: string)
	if self.state ~= "Round" or not self.alive[player] then
		return
	end
	self.alive[player] = false

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		self:emberBurst(root.Position)
	end
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		-- The default BreakJointsOnDeath does the blocky come-apart, which is the look the style
		-- guide asks for - no custom ragdoll needed.
		hum.Health = 0
	end

	local survivors = self:aliveList()
	if #survivors == 0 then
		self:finish(false)
	end
end

function Rounds.emberBurst(self, at: Vector3)
	local host = Instance.new("Part")
	host.Size = Vector3.new(1, 1, 1)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CFrame = CFrame.new(at)
	host.Parent = workspace

	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(C.LavaHot, C.Ember)
	e.Size = NumberSequence.new(1.6, 0.2)
	e.Lifetime = NumberRange.new(0.4, 0.9)
	e.Speed = NumberRange.new(20, 48)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Rate = 0
	e.Parent = host
	e:Emit(22)
	Debris:AddItem(host, 1.5)
end

function Rounds.finish(self, survivorsWin: boolean)
	if self.state ~= "Round" then
		return
	end
	self.state = "Over"
	self.pickups:stop()

	local survivors = self:aliveList()
	if survivorsWin then
		local names = {}
		for _, p in survivors do
			table.insert(names, p.Name)
		end
		self:banner("SURVIVORS WIN", C.Power, 5, table.concat(names, "   "))
	else
		self:banner("THE DRAGON WINS", C.Lava, 5)
		self:flareEyes()
	end
	if self.onRoundEnd then
		pcall(self.onRoundEnd, #survivors)
	end

	task.delay(ArenaConfig.INTERMISSION_SECONDS, function()
		if self.state == "Over" then
			self.pickups:clear()
			self.state = "Waiting"
			self:start()
		end
	end)
end

-- The dragon's eyes flare on its win. The dragon does not *move* for this (hard rule 2) - it is
-- wherever the real arm is, and a victory animation would put the visual off the hitbox.
function Rounds.flareEyes(self)
	local head = self.dragon.segments and self.dragon.segments[5]
	if not head then
		return
	end
	task.spawn(function()
		for i = 1, 24 do
			local f = 1 - i / 24
			for _, e in head.eyes do
				if e.part.Parent then
					e.part.Size = Vector3.new(1, 1, 1) * (head.spec.thickness * (0.2 + 0.3 * f))
				end
			end
			task.wait(0.08)
		end
		for _, e in head.eyes do
			if e.part.Parent then
				e.part.Size = Vector3.new(1, 1, 1) * (head.spec.thickness * 0.2)
			end
		end
	end)
end

-- ---------------------------------------------------------------------------------------------

function Rounds.setEffects(self, effects: { any }?)
	self.effects = effects or {}
end

function Rounds.step(self, dt: number)
	if self.state == "Round" and os.clock() >= self.endsAt then
		-- The timer ran out with people still standing: they win.
		self:finish(true)
	end

	local now = os.clock()
	if now - self.lastHud >= 1 / HUD_HZ then
		self.lastHud = now
		self:broadcast()
	end
end

function Rounds.broadcast(self)
	local survivors = #self:aliveList()
	local total = 0
	for _ in self.alive do
		total += 1
	end

	-- Chips come from state.effects, so they show the server's clamped remaining time.
	local chips = {}
	for _, e in self.effects do
		table.insert(chips, {
			name = e.name,
			label = Theme.effectLabel(e.name),
			color = Theme.effectColor(e.name),
			remaining = e.remaining or 0,
		})
	end

	-- Who the dead are watching. One survivor for everyone rather than a per-player choice: the
	-- style guide only asks for the name under "SPECTATING", and letting each corpse pick its own
	-- target is a camera feature nobody asked for.
	local watching = self:aliveList()[1]

	local base = {
		state = self.state,
		timeLeft = self.state == "Round" and math.max(0, self.endsAt - os.clock()) or 0,
		survivors = survivors,
		total = math.max(total, survivors),
		effects = chips,
		dormant = self.dragon:isDormant(),
		slamStuds = SLAM_HEIGHT_STUDS,
	}

	-- The slot bar is per player, so the payload is finished per client rather than broadcast.
	for _, player in Players:GetPlayers() do
		local payload = table.clone(base)
		payload.slots = self.pickups:slotView(player)
		payload.alive = self.alive[player] == true
		if not payload.alive and watching and watching ~= player then
			payload.spectating = watching.Name
		end
		Remotes.Hud:FireClient(player, payload)
	end
end

function Rounds.playerAdded(self, player: Player)
	if self.excluded[player] then
		return
	end
	-- Joining mid-round means spectating until the next one: dropping someone into a live arena
	-- next to a swinging head is not a welcome. They get a body when the next round starts.
	if self.state == "Round" or self.state == "Countdown" then
		self.alive[player] = false
	else
		self.alive[player] = true
		task.spawn(function()
			self:spawnInto(player)
		end)
	end
end

function Rounds.playerRemoving(self, player: Player)
	local wasAlive = self.alive[player]
	self.alive[player] = nil
	self.excluded[player] = nil
	if wasAlive and self.state == "Round" and #self:aliveList() == 0 then
		self:finish(false)
	end
end

return Rounds
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19">
				<Properties>
					<string name="Name">Sound</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The arena's audio. Same warm/cool split as the colours: dragon sounds are low and heavy, player
-- sounds are high and bright, so you can tell who did something without looking.
--
-- THE ASSET IDS ARE DELIBERATELY EMPTY. Picking them means browsing the Roblox audio library and
-- listening, and an invented rbxassetid is worse than none: it either fails silently or plays
-- something nobody chose. Fill SOUND in from the library (Creator Store -> Audio, filter to free),
-- and check the licence on anything you add - no copyrighted music. Every call here no-ops on a
-- zero id, so the mode runs silent until they are filled rather than erroring.
--
--   local sound = Sound.new(workspace)
--   sound:ambience(); sound:slam(at); sound:fireStart(head)

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local Sound = {}
Sound.__index = Sound

-- rbxassetid://... Leave at 0 for silence.
local SOUND = {
	ambience   = 0,   -- low volcano rumble, bubbling lava; loops under everything
	roar       = 0,   -- the dragon's roar, on the frame fire starts
	flame      = 0,   -- looping flame roar, while fire lasts
	slam       = 0,   -- deep boom
	sweep      = 0,   -- grinding scrape, loops while sweeping
	pickup     = 0,   -- bright chime
	debuff     = 0,   -- zap, when a player lands an effect
	eliminated = 0,   -- pop
	tick       = 0,   -- the last ten seconds
}

local function make(id: number, parent: Instance, volume: number, looped: boolean?): Sound?
	if id == 0 then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = volume
	s.Looped = looped or false
	s.RollOffMaxDistance = 400
	s.Parent = parent
	return s
end

function Sound.new(parent: Instance)
	local self = setmetatable({}, Sound)
	self.parent = parent
	self.loops = {} :: { [string]: Sound }
	return self
end

-- A one-off at a place in the world, cleaned up after it finishes.
function Sound.at(self, key: string, at: Vector3, volume: number?)
	local id = SOUND[key]
	if not id or id == 0 then
		return
	end
	local host = Instance.new("Part")
	host.Size = Vector3.new(1, 1, 1)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CFrame = CFrame.new(at)
	host.Parent = self.parent
	local s = make(id, host, volume or 0.6)
	if s then
		s:Play()
	end
	Debris:AddItem(host, 6)
end

-- A one-off with no position: UI feedback, which should not get quieter across the arena.
function Sound.ui(self, key: string, volume: number?)
	local id = SOUND[key]
	if not id or id == 0 then
		return
	end
	local s = make(id, SoundService, volume or 0.5)
	if s then
		s:Play()
		Debris:AddItem(s, 6)
	end
end

-- A loop tied to a part, so the flame roar and the sweep scrape come from the head.
function Sound.startLoop(self, key: string, host: Instance, volume: number?)
	if self.loops[key] then
		return
	end
	local s = make(SOUND[key], host, volume or 0.5, true)
	if s then
		s:Play()
		self.loops[key] = s
	end
end

function Sound.stopLoop(self, key: string)
	local s = self.loops[key]
	if s then
		s:Stop()
		s:Destroy()
		self.loops[key] = nil
	end
end

function Sound.ambience(self)
	self:startLoop("ambience", SoundService, 0.35)
end

return Sound
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX20">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX21">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX22">
				<Properties>
					<string name="Name">ArenaHud</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- The arena HUD, and the operator's overhead view. A LocalScript in StarterPlayerScripts.
--
-- Layout follows concepts/refs/slam.png: survivors pill top left, timer top centre with the active
-- effect chips under it, ability bar bottom right. Banners come and go in the centre. Nothing else
-- stays on screen - the scene behind it is busy, and the dragon is the thing to watch.
--
-- THE HUD DECIDES NOTHING. Every number here arrives in the Hud payload from the server. The timer
-- is not counted locally, and the effect chips show `state.effects[].remaining` - the server's
-- clamped value - because a HUD running its own timer drifts and then lies about a debuff that
-- already ended (hard rule 4).
--
-- NO PLAYER-PUNISHING EFFECTS. The debuffs belong to the players, so they never flip this screen,
-- fog it, or shake it. The one thing that does shake the camera is a slam, which is the dragon's
-- doing (style guide section 8).
--
-- Sizes are in Scale where it matters and the slots never drop below 56 px, so the bar stays
-- usable at phone width.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage:WaitForChild("Arena"):WaitForChild("Theme"))
local ArenaConfig = require(ReplicatedStorage.Arena.ArenaConfig)
local Remotes = require(ReplicatedStorage.Arena.Remotes)
local Icons = require(ReplicatedStorage.Arena.Icons)

local C = Theme.Color
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local gui = Instance.new("ScreenGui")
gui.Name = "ArenaHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

-- Small screens. Everything below is laid out at desktop sizes and then scaled as one, so the
-- proportions survive a phone instead of each element needing its own breakpoint. The scale has a
-- floor, and the ability slots have their own minimum below, because a slot that scales down past
-- about 56 px stops being tappable.
local uiScale = Instance.new("UIScale")
uiScale.Parent = gui

local function fitViewport()
	local v = camera.ViewportSize
	-- 1280 wide is the layout's reference width. Narrower screens shrink, wider ones do not grow:
	-- a HUD that scales up on a big monitor just eats the view of the arena.
	uiScale.Scale = math.clamp(math.min(v.X / 1280, v.Y / 720), 0.62, 1)
end

fitViewport()
camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitViewport)

-- Every text element gets an ink stroke: the scene behind it is lava and fire, and unstroked white
-- text disappears over the bright parts.
local function stroke(label: TextLabel, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = C.UiInk
	s.Thickness = thickness or 2
	s.Parent = label
end

local function text(parent: Instance, font: Font, size: number, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.FontFace = font
	l.TextSize = size
	l.TextColor3 = color
	l.Parent = parent
	stroke(l, size > 40 and 3 or 2)
	return l
end

local function panel(parent: Instance): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = C.UiInk
	f.BackgroundTransparency = 0.35
	f.BorderSizePixel = 0
	f.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = f
	return f
end

-- ---------------------------------------------------------------------------------------------
-- Top left: survivors
-- ---------------------------------------------------------------------------------------------

local survivorsPill = panel(gui)
survivorsPill.Position = UDim2.new(0, 16, 0, 16)
survivorsPill.Size = UDim2.new(0, 150, 0, 48)

local survivorsLabel = text(survivorsPill, Theme.Font.Label, 16, C.UiText)
survivorsLabel.Position = UDim2.new(0, 12, 0, 6)
survivorsLabel.Size = UDim2.new(1, -24, 0, 16)
survivorsLabel.TextXAlignment = Enum.TextXAlignment.Left
survivorsLabel.Text = "SURVIVORS"

local survivorsCount = text(survivorsPill, Theme.Font.Display, 20, C.UiText)
survivorsCount.Position = UDim2.new(0, 12, 0, 24)
survivorsCount.Size = UDim2.new(1, -24, 0, 20)
survivorsCount.TextXAlignment = Enum.TextXAlignment.Left
survivorsCount.Text = "0/0"

-- ---------------------------------------------------------------------------------------------
-- Top centre: timer and the active effect chips
-- ---------------------------------------------------------------------------------------------

local timer = text(gui, Theme.Font.Display, 48, C.UiText)
timer.AnchorPoint = Vector2.new(0.5, 0)
timer.Position = UDim2.new(0.5, 0, 0, 10)
timer.Size = UDim2.new(0, 200, 0, 56)
timer.Text = "0:00"

local chipRow = Instance.new("Frame")
chipRow.BackgroundTransparency = 1
chipRow.AnchorPoint = Vector2.new(0.5, 0)
chipRow.Position = UDim2.new(0.5, 0, 0, 68)
chipRow.Size = UDim2.new(0, 460, 0, 28)
chipRow.Parent = gui

local chipLayout = Instance.new("UIListLayout")
chipLayout.FillDirection = Enum.FillDirection.Horizontal
chipLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
chipLayout.Padding = UDim.new(0, 6)
chipLayout.SortOrder = Enum.SortOrder.LayoutOrder
chipLayout.Parent = chipRow

-- One chip per active effect: icon, seconds remaining, border in the effect's colour. Rebuilt from
-- the payload each tick rather than diffed - at most six chips, so the churn is not worth the
-- bookkeeping.
local function drawChips(effects: { any })
	for _, child in chipRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for i, e in effects do
		local chip = panel(chipRow)
		chip.Size = UDim2.new(0, 96, 1, 0)
		chip.LayoutOrder = i
		local border = Instance.new("UIStroke")
		border.Color = e.color
		border.Thickness = 2
		border.Parent = chip

		local icon = Icons.draw(chip, e.name, e.color)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 5, 0.5, 0)
		icon.Size = UDim2.new(0, 20, 0, 20)

		local label = text(chip, Theme.Font.Label, 13, e.color)
		label.Position = UDim2.new(0, 30, 0, 0)
		label.Size = UDim2.new(1, -36, 1, 0)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Text = ("%s %ds"):format(e.label, math.ceil(e.remaining))
	end
end

-- ---------------------------------------------------------------------------------------------
-- Bottom right: the ability bar
-- ---------------------------------------------------------------------------------------------

-- 64 px at full scale. `fitSlots` below keeps the rendered size at or above SLOT_MIN_PX by
-- compensating for the global UIScale, because the style guide's floor is a *touch target*, and a
-- target that shrinks with the rest of the HUD stops being one.
local SLOT_PX = 64
local SLOT_MIN_PX = 56

local bar = Instance.new("Frame")
bar.BackgroundTransparency = 1
bar.AnchorPoint = Vector2.new(1, 1)
bar.Position = UDim2.new(1, -16, 1, -16)
bar.Size = UDim2.new(0, (SLOT_PX + 8) * ArenaConfig.ABILITY_SLOTS, 0, SLOT_PX)
bar.Parent = gui

local barLayout = Instance.new("UIListLayout")
barLayout.FillDirection = Enum.FillDirection.Horizontal
barLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
barLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
barLayout.Padding = UDim.new(0, 8)
barLayout.SortOrder = Enum.SortOrder.LayoutOrder
barLayout.Parent = bar

local slotTiles = {}
for i = 1, ArenaConfig.ABILITY_SLOTS do
	local tile = panel(bar)
	tile.Size = UDim2.new(0, SLOT_PX, 0, SLOT_PX)
	tile.LayoutOrder = i

	local border = Instance.new("UIStroke")
	border.Color = C.UiText
	border.Thickness = 2
	border.Parent = tile

	local label = text(tile, Theme.Font.Label, 11, C.UiText)
	label.Position = UDim2.new(0, 2, 1, -16)
	label.Size = UDim2.new(1, -4, 0, 14)
	label.Text = ""
	label.ZIndex = 3

	local key = text(tile, Theme.Font.Label, 12, C.UiText)
	key.Position = UDim2.new(0, 4, 0, 2)
	key.Size = UDim2.new(0, 14, 0, 14)
	key.Text = tostring(i)
	key.TextTransparency = 0.4

	-- Cooldown is a bottom-up fill, so a slot visibly comes back rather than just reappearing.
	local cd = Instance.new("Frame")
	cd.BackgroundColor3 = C.UiInk
	cd.BackgroundTransparency = 0.5
	cd.BorderSizePixel = 0
	cd.AnchorPoint = Vector2.new(0, 1)
	cd.Position = UDim2.new(0, 0, 1, 0)
	cd.Size = UDim2.new(1, 0, 0, 0)
	cd.Parent = tile

	local button = Instance.new("TextButton")
	button.BackgroundTransparency = 1
	button.Text = ""
	button.Size = UDim2.new(1, 0, 1, 0)
	button.Parent = tile
	button.Activated:Connect(function()
		Remotes.SlotFire:FireServer(i)
	end)

	slotTiles[i] = { tile = tile, border = border, label = label, cd = cd, icon = nil, held = nil }
end

local function fitSlots()
	local px = math.max(SLOT_PX, SLOT_MIN_PX / math.max(uiScale.Scale, 0.01))
	for _, t in slotTiles do
		t.tile.Size = UDim2.new(0, px, 0, px)
	end
	bar.Size = UDim2.new(0, (px + 8) * ArenaConfig.ABILITY_SLOTS, 0, px)
end

fitSlots()
camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitSlots)

-- Number keys fire the slots too; the tiles are for touch.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
	if n >= 1 and n <= ArenaConfig.ABILITY_SLOTS then
		Remotes.SlotFire:FireServer(n)
	end
end)

local function drawSlots(slots: { any })
	for i, tile in slotTiles do
		local s = slots and slots[i]

		-- Only redraw when the contents actually change. drawSlots runs on every payload, and a
		-- slot that rebuilds its frames eight times a second visibly flickers.
		local want = s and s.name or nil
		if want ~= tile.held then
			tile.held = want
			if tile.icon then
				tile.icon:Destroy()
				tile.icon = nil
			end
			if want then
				tile.icon = Icons.draw(tile.tile, want, s.color)
			end
		end

		if s and s.name then
			-- A slot holding a picked-up debuff carries that effect's colour.
			tile.border.Color = s.color
			tile.border.Thickness = 3
			tile.label.Text = s.label
			tile.label.TextColor3 = s.color
			tile.cd.Size = UDim2.new(1, 0, 0, 0)
		elseif s and s.cooldown then
			tile.border.Color = C.UiText
			tile.border.Thickness = 2
			tile.label.Text = ""
			local f = math.clamp(s.cooldown / ArenaConfig.ABILITY_COOLDOWN_S, 0, 1)
			tile.cd.Size = UDim2.new(1, 0, f, 0)
		else
			-- An empty, ready slot glows Power: cool, because it belongs to the player.
			tile.border.Color = C.Power
			tile.border.Thickness = 3
			tile.label.Text = ""
			tile.cd.Size = UDim2.new(1, 0, 0, 0)
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- Banners and the spectate line
-- ---------------------------------------------------------------------------------------------

local banner = text(gui, Theme.Font.Display, 96, C.UiText)
banner.AnchorPoint = Vector2.new(0.5, 0.5)
banner.Position = UDim2.new(0.5, 0, 0.38, 0)
banner.Size = UDim2.new(1, -40, 0, 110)
banner.Text = ""
-- Scaled, with a ceiling: "THE DRAGON WINS" at a fixed 96 px runs off the side of a phone, and
-- TextScaled alone would blow a short word like "3" up to fill the whole band.
banner.TextScaled = true
local bannerMax = Instance.new("UITextSizeConstraint")
bannerMax.MaxTextSize = 96
bannerMax.MinTextSize = 28
bannerMax.Parent = banner

local bannerSub = text(gui, Theme.Font.Label, 20, C.UiText)
bannerSub.AnchorPoint = Vector2.new(0.5, 0.5)
bannerSub.Position = UDim2.new(0.5, 0, 0.38, 70)
bannerSub.Size = UDim2.new(1, -40, 0, 26)
bannerSub.Text = ""

local spectating = text(gui, Theme.Font.Label, 16, C.UiText)
spectating.AnchorPoint = Vector2.new(0.5, 1)
spectating.Position = UDim2.new(0.5, 0, 1, -12)
spectating.Size = UDim2.new(0, 400, 0, 20)
spectating.Text = ""

local bannerToken = 0
Remotes.Banner.OnClientEvent:Connect(function(info)
	bannerToken += 1
	local mine = bannerToken
	banner.Text = info.text
	banner.TextColor3 = info.color
	bannerSub.Text = info.sub or ""
	task.delay(info.seconds or 2, function()
		if bannerToken == mine then
			banner.Text = ""
			bannerSub.Text = ""
		end
	end)
end)

-- ---------------------------------------------------------------------------------------------
-- Camera shake: a slam, and only a slam
-- ---------------------------------------------------------------------------------------------

local shakeUntil = 0
local shakeStrength = 0
-- Declared here, above the RenderStepped closure that reads it. Declaring it further down next to
-- the Hud handler would make that closure capture a global of the same name instead, and the
-- pulse would silently never run.
local timerUrgent = false

Remotes.Shake.OnClientEvent:Connect(function(strength, seconds)
	shakeStrength = math.max(shakeStrength, strength)
	shakeUntil = math.max(shakeUntil, os.clock() + seconds)
end)

RunService.RenderStepped:Connect(function()
	if timerUrgent then
		-- A gentle pulse, not a flash: the last ten seconds should raise the pulse without
		-- competing with the fire for attention.
		timer.TextTransparency = 0.25 + 0.25 * math.sin(os.clock() * 6)
	end
	if os.clock() >= shakeUntil then
		shakeStrength = 0
		return
	end
	-- Offsets the camera's CFrame only; the default third-person camera is left in charge
	-- (style guide section 10), so nothing fights the player's own control.
	local f = (shakeUntil - os.clock())
	local amp = shakeStrength * math.min(f, 0.4) * 6
	camera.CFrame = camera.CFrame * CFrame.new(
		(math.random() - 0.5) * amp,
		(math.random() - 0.5) * amp,
		0)
end)

-- ---------------------------------------------------------------------------------------------
-- The HUD payload
-- ---------------------------------------------------------------------------------------------

Remotes.Hud.OnClientEvent:Connect(function(payload)
	spectating.Text = payload.spectating and ("SPECTATING " .. string.upper(payload.spectating)) or ""

	survivorsCount.Text = ("%d/%d"):format(payload.survivors or 0, payload.total or 0)

	local left = payload.timeLeft or 0
	timer.Text = ("%d:%02d"):format(math.floor(left / 60), math.floor(left % 60))
	-- The pulse itself runs on RenderStepped below. Driving it from this handler would step it at
	-- the payload rate (8 Hz), which reads as a stutter rather than a pulse.
	slamStuds = payload.slamStuds or slamStuds
	timerUrgent = left <= 10 and payload.state == "Round"
	timer.TextColor3 = timerUrgent and C.UiDanger or C.UiText
	if not timerUrgent then
		timer.TextTransparency = 0
	end

	drawChips(payload.effects or {})
	drawSlots(payload.slots or {})
end)

-- ---------------------------------------------------------------------------------------------
-- The aerial operator view
-- ---------------------------------------------------------------------------------------------

-- Press V to switch any client between the normal player camera and the aerial view. The server
-- can also assign it on join (the ArenaOperator attribute, set from OPERATOR_NAME in ArenaMain),
-- but the key is the one that always works: in Play Solo your player is named after your Roblox
-- account, not "Player1", so a name match is exactly the thing that fails when you are trying to
-- get a second screen up in a hurry.
local AERIAL_KEY = Enum.KeyCode.V

local OPERATOR_FACING = {
	mirror = "CONTROLS INVERTED",
	fog = "CONTROLS LAGGING",
	molasses = "CONTROLS SLUGGISH",
	freeze = "ARM FROZEN",
	earthquake = "ARM SHAKING",
	butterfingers = "JAW JAMMED",
}

-- Debuffs that change what the operator's own hands are doing, shown large because they are the
-- reason the arm is not going where they pushed it.
local opText = text(gui, Theme.Font.Display, 40, C.UiDanger)
opText.AnchorPoint = Vector2.new(0.5, 0)
opText.Position = UDim2.new(0.5, 0, 0, 110)
opText.Size = UDim2.new(1, -40, 0, 50)
opText.Text = ""
opText.Visible = false

local hint = text(gui, Theme.Font.Label, 14, C.UiText)
hint.AnchorPoint = Vector2.new(1, 0)
hint.Position = UDim2.new(1, -16, 0, 16)
hint.Size = UDim2.new(0, 220, 0, 18)
hint.TextXAlignment = Enum.TextXAlignment.Right
hint.TextTransparency = 0.35
hint.Text = "V — AERIAL VIEW"

local aerial = false
local highlights = {} :: { [Model]: Highlight }
local aerialConns = {} :: { RBXScriptConnection }
local aerialView: CFrame? = nil

-- Dark avatars vanish against obsidian from overhead, and the operator has to see who they are
-- about to land a head on. Only the aerial view outlines them; the players never see this.
local function mark(char: Model)
	if not aerial or highlights[char] then
		return
	end
	local h = Instance.new("Highlight")
	h.OutlineColor = C.UiText
	h.FillTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Adornee = char
	h.Parent = char
	highlights[char] = h
end

local function clearMarks()
	for char, h in highlights do
		h:Destroy()
		highlights[char] = nil
	end
end

-- Where to put the camera. Nil until the arena exists, which only happens once `hello` arrives -
-- so this is recomputed on each toggle rather than cached from the first attempt.
local function aerialCFrame(): CFrame?
	local arenaModel = workspace:FindFirstChild("Arena")
	local floor = arenaModel and arenaModel:FindFirstChild("Floor")
	if not (floor and floor:IsA("BasePart")) then
		return nil
	end
	local centre = floor.Position
	-- Fractions of the floor's own size, not fixed studs, so the framing survives a change to
	-- ARENA_SCALE. Both live in ArenaConfig - turn AERIAL_HEIGHT_FRAC down to come in closer.
	local span = math.max(floor.Size.X, floor.Size.Z)
	local height = span * ArenaConfig.AERIAL_HEIGHT_FRAC
	-- Pulled back toward the far edge and tilted, not straight down: a pure top-down view hides
	-- how high the head is, which is the one thing the operator needs to judge.
	local back = floor.Size.Z * ArenaConfig.AERIAL_BACK_FRAC
	return CFrame.lookAt(centre + Vector3.new(0, height, back), centre)
end

-- ---------------------------------------------------------------------------------------------
-- The operator's aiming aids
--
-- The operator flies a real 3D arm from a flat overhead view. From up there, "directly above that
-- player" and "thirty studs short of them" look the same, and there is no cue at all for height -
-- so without help they are aiming blind, which is not a skill problem to be overcome.
--
-- This does not break hard rule 1. That rule forbids telegraphs on the PLAYERS' screens, so that
-- players dodge by watching the dragon instead of reading a marker that says where the strike will
-- land. Everything below shows where the jaw is RIGHT NOW - the same class of thing as the
-- dragon's own shadow, which rule 1 explicitly allows - and all of it is built here, on the
-- operator's client, so it does not replicate and no player ever sees it.
--
-- Three cues, because they answer three different questions:
--   the disc    - where on the floor am I? turns red when a player is under me
--   the line    - how high am I? its length IS the height, which is the cue overhead view destroys
--   the readout - the numbers, plus who I am over
-- ---------------------------------------------------------------------------------------------

local aim = nil :: any
local slamStuds = 5          -- replaced by the server's converted figure on the first payload

local function buildAim()
	local folder = Instance.new("Folder")
	folder.Name = "OperatorAim"
	folder.Parent = workspace

	local function fx(name: string, size: Vector3, colour: Color3, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = colour
		p.Size = size
		if shape then
			p.Shape = shape
		end
		p.Parent = folder
		return p
	end

	local disc = fx("Disc", Vector3.new(0.4, 1, 1), C.DragonEye, Enum.PartType.Cylinder)
	disc.Transparency = 0.72
	local dot = fx("Dot", Vector3.new(0.5, 2.5, 2.5), C.WhiteHot, Enum.PartType.Cylinder)
	local line = fx("Drop", Vector3.new(0.7, 0.7, 1), C.DragonEye)
	line.Transparency = 0.45

	return { folder = folder, disc = disc, dot = dot, line = line }
end

local readout = text(gui, Theme.Font.Display, 22, C.UiText)
readout.AnchorPoint = Vector2.new(0.5, 1)
readout.Position = UDim2.new(0.5, 0, 1, -16)
readout.Size = UDim2.new(0, 560, 0, 28)
readout.Text = ""
readout.Visible = false

-- The jaw tips, read off the replicated dragon. The head segment spans wrist_roll -> tip and is
-- centred on its own pivot, so half its length forward along the local Z axis is the tip - the
-- same point the server calls arm.tip.
local function dragonTip(): Vector3?
	local dragon = workspace:FindFirstChild("Dragon")
	local head = dragon and dragon:FindFirstChild("Head")
	local core = head and head:FindFirstChild("Core")
	if not (core and core:IsA("BasePart")) then
		return nil
	end
	return (core.CFrame * CFrame.new(0, 0, core.Size.Z / 2)).Position
end

local function floorTopY(): number?
	local arenaModel = workspace:FindFirstChild("Arena")
	local floor = arenaModel and arenaModel:FindFirstChild("Floor")
	if not (floor and floor:IsA("BasePart")) then
		return nil
	end
	return floor.Position.Y + floor.Size.Y / 2
end

local function updateAim()
	if not aim then
		return
	end
	local tip = dragonTip()
	local floorY = floorTopY()
	if not tip or not floorY then
		aim.folder.Parent = nil
		readout.Text = ""
		return
	end
	aim.folder.Parent = workspace

	local ground = Vector3.new(tip.X, floorY + 0.08, tip.Z)
	local height = math.max(tip.Y - floorY, 0)

	-- Who is under the jaw. Measured flat, ignoring height, because that is exactly the question
	-- the overhead view cannot answer by itself.
	local radius = ArenaConfig.AIM_RETICLE_RADIUS
	local over: Player? = nil
	local nearest = math.huge
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and hum and hum.Health > 0 then
			local flat = (Vector3.new(root.Position.X, 0, root.Position.Z)
				- Vector3.new(ground.X, 0, ground.Z)).Magnitude
			if flat < nearest then
				nearest = flat
				if flat <= radius then
					over = p
				end
			end
		end
	end

	-- Warm throughout: this is the dragon's own aim, and rule 7 keeps the cool colours for the
	-- players. Red for "someone is under you", white-hot for "low enough to land a slam".
	local inRange = height <= slamStuds
	local colour = C.DragonEye
	if over then
		colour = C.UiDanger
	elseif inRange then
		colour = C.WhiteHot
	end

	aim.disc.Size = Vector3.new(0.4, radius * 2, radius * 2)
	aim.disc.CFrame = CFrame.new(ground) * CFrame.Angles(0, 0, math.pi / 2)
	aim.disc.Color = colour
	aim.disc.Transparency = over and 0.5 or 0.72

	aim.dot.CFrame = CFrame.new(ground + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	aim.dot.Color = colour

	-- The line's length is the height. That is the whole point of it: an overhead view destroys
	-- depth, and a bar that visibly shortens as the head comes down puts it back.
	-- Floored a little above the ground. At the bottom of a slam the tip IS the floor, and
	-- CFrame.lookAt with two coincident points produces a NaN CFrame - which would blow up the
	-- operator's view at the exact moment they most need it.
	local top = Vector3.new(tip.X, math.max(tip.Y, floorY + 0.3), tip.Z)
	aim.line.Size = Vector3.new(0.7, 0.7, math.max(height, 0.1))
	aim.line.CFrame = CFrame.lookAt(ground:Lerp(top, 0.5), top)
	aim.line.Color = colour

	local where
	if over then
		where = "OVER " .. string.upper(over.Name)
	elseif nearest < math.huge then
		where = string.format("NEAREST %d", math.floor(nearest))
	else
		where = "NO TARGET"
	end
	readout.Text = string.format("HEIGHT %d    %s%s", math.floor(height), where,
		inRange and "    STRIKE RANGE" or "")
	readout.TextColor3 = colour
end

local function setAimVisible(on: boolean)
	if on and ArenaConfig.AIM_SHOW then
		if not aim then
			aim = buildAim()
		end
		readout.Visible = true
	else
		if aim then
			aim.folder:Destroy()
			aim = nil
		end
		readout.Visible = false
	end
end

local function setAerial(on: boolean)
	if on == aerial then
		return
	end

	if on then
		local view = aerialCFrame()
		if not view then
			-- No floor yet means no `hello` yet. Say so rather than silently doing nothing, which
			-- looks identical to a broken keybind.
			hint.Text = "NO ARENA YET — START THE ROBOT PROCESS"
			task.delay(3, function()
				if not aerial then
					hint.Text = "V — AERIAL VIEW"
				end
			end)
			return
		end
		aerial = true
		aerialView = view
		-- Whoever is up here IS the dragon. The server takes their body away and stops counting
		-- them as a survivor; without telling it, the dragon stays a player and a round where it
		-- kills everyone never ends.
		Remotes.SetOperator:FireServer(true)
		hint.Text = "V — PLAYER VIEW"
		bar.Visible = false              -- the ability bar is the players' tool
		opText.Visible = true
		setAimVisible(true)

		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = view
		camera.FieldOfView = ArenaConfig.AERIAL_FOV

		for _, p in Players:GetPlayers() do
			if p.Character then
				mark(p.Character)
			end
		end
		for _, p in Players:GetPlayers() do
			table.insert(aerialConns, p.CharacterAdded:Connect(mark))
		end
		table.insert(aerialConns, Players.PlayerAdded:Connect(function(p)
			table.insert(aerialConns, p.CharacterAdded:Connect(mark))
		end))
		-- Re-asserted every frame: the engine takes the camera back whenever it decides the player
		-- needs a default one, and a view that silently drops to third person mid-demo is worse
		-- than one assignment a frame.
		table.insert(aerialConns, RunService.RenderStepped:Connect(function()
			if aerial and aerialView then
				if camera.CameraType ~= Enum.CameraType.Scriptable then
					camera.CameraType = Enum.CameraType.Scriptable
				end
				camera.CFrame = aerialView
				updateAim()
			end
		end))
	else
		aerial = false
		aerialView = nil
		Remotes.SetOperator:FireServer(false)
		hint.Text = "V — AERIAL VIEW"
		bar.Visible = true
		opText.Visible = false
		setAimVisible(false)
		for _, c in aerialConns do
			c:Disconnect()
		end
		table.clear(aerialConns)
		clearMarks()

		-- Hand the camera back. Without re-pointing CameraSubject the player is left staring at
		-- nothing when they toggle out after respawning.
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70          -- the engine default, so the player view is unchanged
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			camera.CameraSubject = hum
		end
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == AERIAL_KEY then
		setAerial(not aerial)
	end
end)

-- The server can still assign the view on join. Read rather than awaited: the attribute is set as
-- the player joins, which can be before this script runs, so checking the current value first is
-- what makes it work at all.
local OPERATOR_ATTRIBUTE = "ArenaOperator"

local function checkOperator()
	if player:GetAttribute(OPERATOR_ATTRIBUTE) and not aerial then
		-- The arena may not be built yet. Keep trying until it is, so an operator assigned on join
		-- still lands in the aerial view once the robot process connects.
		task.spawn(function()
			while player:GetAttribute(OPERATOR_ATTRIBUTE) and not aerial do
				setAerial(true)
				if aerial then
					break
				end
				task.wait(1)
			end
		end)
	end
end

player:GetAttributeChangedSignal(OPERATOR_ATTRIBUTE):Connect(checkOperator)
checkOperator()

-- The operator-facing debuff text follows the same payload the HUD does.
Remotes.Hud.OnClientEvent:Connect(function(payload)
	if not aerial then
		return
	end
	local lines = {}
	for _, e in (payload.effects or {}) do
		local msg = OPERATOR_FACING[e.name]
		if msg then
			table.insert(lines, msg)
		end
	end
	opText.Text = table.concat(lines, "   ")
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
